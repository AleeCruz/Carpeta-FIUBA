Object subclass: #AlgoConsejo	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!AlgoConsejo class	instanceVariableNames: 'criterio futbolistas resultado conmebolPaises'!!AlgoConsejo class methodsFor: 'as yet unclassified' stamp: 'Alexander 10/17/2025 15:00'!conCriterioMas: unCriterio 	|unAlgoConsejo|	criterio := unCriterio.	futbolistas := OrderedCollection new.	conmebolPaises := OrderedCollection new.	unAlgoConsejo := self .	unAlgoConsejo inicializandoPaisesConmebol.! !!AlgoConsejo class methodsFor: 'as yet unclassified' stamp: 'Alexander 10/17/2025 14:59'!inicializandoPaisesConmebol	conmebolPaises add: 'Bolivia'.	conmebolPaises add: 'Brasil'.	conmebolPaises add: 'Chile'.	conmebolPaises add: 'Colombia'.	conmebolPaises add: 'Ecuador'.	conmebolPaises add: 'Paraguay'.	conmebolPaises add: 'Perú'.	conmebolPaises add: 'Peru'.	conmebolPaises add: 'Uruguay'.	conmebolPaises add: 'Venezuela'.	conmebolPaises add: 'Argentina'.! !!AlgoConsejo class methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 20:18'!cambiarCriterioA: unCriterio	criterio := unCriterio . 	! !!AlgoConsejo class methodsFor: 'not defined category' stamp: 'Alexander 10/15/2025 13:57'!registrarFutbolistaConNombre: unNombreDeFutbolista dePeso: unPeso yAltura: unaAltura yEdad: unaEdad yProvenienteDelClub: unClub DePais: unPais |unFutbolista|('Argentina' = unPais )	ifTrue: [ 			unFutbolista := Argentino new.		 ]	ifFalse: [ 			(conmebolPaises includes: unPais )				ifTrue: [ unFutbolista := Conmebol new. ]				ifFalse: [ 					(unaEdad  > 33)						ifTrue: [ unFutbolista := Extranjero_Veterano new ]						ifFalse: [ unFutbolista := Extranjero new ]					 ]		].	unFutbolista asignarNombre: unNombreDeFutbolista  Peso: unPeso Altura: unaAltura  Edad: unaEdad  Club: unClub  Pais: unPais Criterio: criterio.	unFutbolista calculaTuValorEnPesos. 	futbolistas add: unFutbolista.	! !!AlgoConsejo class methodsFor: 'not defined category' stamp: 'Alexander 10/17/2025 15:02'!obtenerFutbolistaSegunCriterio|unFutbolista |(criterio = 'Caro')	ifTrue: [ 		unFutbolista := futbolistas  detectMax: [ :f | (f dameTuValorEnPesos ) ].	 	]	ifFalse: [ 		unFutbolista := futbolistas  detectMin: [ :f | (f dameTuValorEnPesos ) ].		 ].^ unFutbolista dameTuNombre .! !!AlgoConsejo class methodsFor: 'not defined category' stamp: 'Alexander 10/15/2025 12:31'!valorDe: unNombreFutbolista|unFutbolista valor|valor := Valor new.unFutbolista := futbolistas detect: [ :f | (f dameTuNombre) = unNombreFutbolista].valor asignaResultado: (unFutbolista dameTuValorEnPesos).^ valor 	 ! !Object subclass: #Futbolista	instanceVariableNames: 'nombre peso altura edad club pais criterio valorEnPesos'	classVariableNames: ''	package: 'TP1'!!Futbolista methodsFor: 'initialization' stamp: 'Alexander 10/15/2025 12:18'!initialize 	nombre := 'No asignado'.	peso := 0.	altura := 0.00.	edad := 0.	club := 'No Asigando'.	pais := 'No Asignado'.	criterio := 'No Asignado'.! !!Futbolista methodsFor: 'not defined category' stamp: 'Alexander 10/15/2025 20:44'!dameTuNombre ^ nombre.! !!Futbolista methodsFor: 'not defined category' stamp: 'Alexander 10/17/2025 17:13'!asignarNombre: unNombre Peso: unPeso Altura: unaAltura Edad: unaEdad Club: unClub Pais: unPais Criterio: unCriterio	(unPeso <= 0) ifTrue:   [ ValorPesoInvalido new signal ].	(unaAltura <=0) ifTrue: [ ValorAlturaInvalido new signal ].	(unaEdad  <=0) ifTrue: [ ValorEdadInvalido  new signal ].	nombre := unNombre.	peso := unPeso.	altura := unaAltura .	edad := unaEdad .	club := unClub .	pais := unPais.	criterio := unCriterio.! !!Futbolista methodsFor: 'not defined category' stamp: 'Alexander 10/15/2025 12:23'!dameTuValorEnPesos  ^ valorEnPesos ! !Futbolista subclass: #Argentino	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Argentino methodsFor: 'not defined category' stamp: 'Alexander 10/15/2025 12:43'!calculaTuValorEnPesos	valorEnPesos := ((peso * altura)/edad)*1.1.! !Futbolista subclass: #Conmebol	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Conmebol methodsFor: 'not defined category' stamp: 'Alexander 10/15/2025 12:44'!calculaTuValorEnPesos 		valorEnPesos := ((peso * altura)/edad)*1.25.! !Futbolista subclass: #Extranjero	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Extranjero methodsFor: 'not defined category' stamp: 'Alexander 10/15/2025 12:46'!calculaTuValorEnPesos 	valorEnPesos := ((peso * altura)/edad)*1.5.! !Futbolista subclass: #Extranjero_Veterano	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Extranjero_Veterano methodsFor: 'not defined category' stamp: 'Alexander 10/15/2025 13:43'!calculaTuValorEnPesos 	valorEnPesos :=  ((100*peso*(altura sqrt)) / (edad raisedTo: 3))*1.5.! !Object subclass: #Valor	instanceVariableNames: 'resultado'	classVariableNames: ''	package: 'TP1'!!Valor methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 12:09'!asignaResultado: unResultado 	resultado := unResultado .! !!Valor methodsFor: 'not defined category' stamp: 'Alexander 10/15/2025 16:43'!compararCon: unValorEsperado precision: unaPresicion^ unValorEsperado closeTo:  resultado  precision: unaPresicion . ! !!Valor methodsFor: 'not defined category' stamp: 'Alexander 10/15/2025 18:05'!compararConValorEnReales: unValorEnReales precision: unaPresicionresultado  := (resultado/245).^(unValorEnReales closeTo: resultado  precision: unaPresicion  )! !!Valor methodsFor: 'not defined category' stamp: 'Alexander 10/17/2025 17:43'!obtenerResultado	^resultado ! !Error subclass: #ValorAlturaInvalido	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!Error subclass: #ValorEdadInvalido	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!Error subclass: #ValorPesoInvalido	instanceVariableNames: 