TestCase subclass: #PuntoTest	instanceVariableNames: ''	classVariableNames: ''	package: 'PuntosYRectas-Test'!!PuntoTest methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 11:49'!test01ObtenerRhoDeUnPuntoInstanciadoEnCoordenadasCartesianas	" Arrange "	| punto rho |	punto := Punto conX: 3 eY: 4.		" Act "	rho := punto rho.		" Assert "	self assert: rho equals: 5.! !!PuntoTest methodsFor: 'tests' stamp: 'SV 8/27/2024 12:01'!test03ObtenerXDeUnPuntoInstanciadoEnCoordenadasCartesianas	" Arrange "	| punto x |	punto := Punto conX: 3 eY: 4.		" Act "	x := punto x.		" Assert "	self assert: x equals: 3.! !!PuntoTest methodsFor: 'tests' stamp: 'SV 8/27/2024 12:09'!test06ObtenerYDeUnPuntoInstanciadoEnCoordenadasPolares	" Arrange "	| punto y |	punto := Punto conRho: 5 yTheta: 0.92.		" Act "	y := punto y.		" Assert "	self assert: y closeTo: 4 precision: 0.1.! !!PuntoTest methodsFor: 'tests' stamp: 'SV 8/27/2024 13:54'!test08DistanciaEntreDosPuntos	" Arrange "	| punto1 punto2 distancia|	punto1 := Punto conRho: 5 yTheta: 0.921.	punto2 := Punto conX: 2 eY: 1.		" Act "	distancia := punto1 distancia: punto2.		" Assert "	self assert: distancia closeTo: (10 sqrt) precision: 0.1.! !!PuntoTest methodsFor: 'tests' stamp: 'SV 8/27/2024 12:02'!test04ObtenerYDeUnPuntoInstanciadoEnCoordenadasCartesianas	" Arrange "	| punto y |	punto := Punto conX: 3 eY: 4.		" Act "	y := punto y.		" Assert "	self assert: y equals: 4.! !!PuntoTest methodsFor: 'tests' stamp: 'SV 8/27/2024 14:01'!test09DistanciaEntrePuntoYUnaRecta	" Arrange "	| punto recta distancia|	punto := Punto conX: 2 eY: 1.	recta := Recta conPendiente: 3 yOrdenadaAlOrigen: 3.		" Act "	distancia := punto distancia: recta.		" Assert "	self assert: distancia closeTo: 21 precision: 0.1.! !!PuntoTest methodsFor: 'tests' stamp: 'SV 8/27/2024 12:00'!test02ObtenerThetaDeUnPuntoInstanciadoEnCoordenadasCartesianas	" Arrange "	| punto theta |	punto := Punto conX: 3 eY: 4.		" Act "	theta := punto theta.		" Assert "	self assert: theta closeTo: 0.927 precision: 0.01 .! !!PuntoTest methodsFor: 'tests' stamp: 'SV 8/27/2024 12:44'!test07ObtenerProductoInternoEntreDosPuntos	" Arrange "	| punto1 punto2 productoInterno|	punto1 := Punto conRho: 5 yTheta: 0.921.	punto2 := Punto conX: 2 eY: 1.		" Act "	productoInterno := punto1 * punto2.		" Assert "	self assert: productoInterno closeTo: 10 precision: 0.1.! !!PuntoTest methodsFor: 'tests' stamp: 'SV 8/27/2024 12:08'!test05ObtenerXDeUnPuntoInstanciadoEnCoordenadasPolares	" Arrange "	| punto x |	punto := Punto conRho: 5 yTheta: 0.92.		" Act "	x := punto x.		" Assert "	self assert: x closeTo: 3 precision: 0.1.! !TestCase subclass: #RectaTest	instanceVariableNames: ''	classVariableNames: ''	package: 'PuntosYRectas-Test'!!RectaTest methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 12:58'!test01ObtenerPendienteDeUnaRecta	" Arrange "	| recta pendiente|	recta := Recta conPendiente: 3 yOrdenadaAlOrigen: 3.		" Act "	pendiente := recta pendiente.		" Assert "	self assert: pendiente equals: 3.! !!RectaTest methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 13:13'!test04DosRectasQueNoSonParaleleasTienenDistanciaCero	" Arrange "	| recta1 recta2 distancia|	recta1 := Recta conPendiente: 3 yOrdenadaAlOrigen: 3.	recta2 := Recta conPendiente: -1/3 yOrdenadaAlOrigen: 0.		" Act "	distancia := recta1 distanciaConRecta: recta2.		" Assert "	self assert: distancia closeTo: 0 precision: 0.1.! !!RectaTest methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 13:02'!test02DosRectasSonParalelas	" Arrange "	| recta1 recta2 paralela|	recta1 := Recta conPendiente: 3 yOrdenadaAlOrigen: 3.	recta2 := Recta conPendiente: 3 yOrdenadaAlOrigen: 0.		" Act "	paralela := recta1 esParalela: recta2.		" Assert "	self assert: paralela.! !!RectaTest methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 13:05'!test03DosRectasSonPerpendiculares	" Arrange "	| recta1 recta2 perpendicular|	recta1 := Recta conPendiente: 3 yOrdenadaAlOrigen: 3.	recta2 := Recta conPendiente: -1/3 yOrdenadaAlOrigen: 0.		" Act "	perpendicular := recta1 esPerpendicular: recta2.		" Assert "	self assert: perpendicular.! !!RectaTest methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 13:57'!test05DosRectasParaleleasTienenDistancia	" Arrange "	| recta1 recta2 distancia|	recta1 := Recta conPendiente: 3 yOrdenadaAlOrigen: 3.	recta2 := Recta conPendiente: 3 yOrdenadaAlOrigen: 0.		" Act "	distancia := recta1 distancia: recta2.		" Assert "	self assert: distancia closeTo: 3 / 10 sqrt precision: 0.1.! !