Object subclass: #Punto	instanceVariableNames: 'x y'	classVariableNames: ''	package: 'PuntosYRectas'!!Punto methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 12:08'!conRho: unRho yTheta: unTheta 	self conX: (unTheta cos * unRho) eY: (unTheta sin * unRho)! !!Punto methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 13:56'!distancia: unPunto 	^unPunto distanciaConPuntoX: x eY: y.! !!Punto methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 11:54'!rho	^ ((x ** 2) + (y ** 2)) sqrt! !!Punto methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 13:56'!distanciaConPuntoX: unX eY: unY 	^(((unX - x) ** 2) +  ((unY - y) ** 2)) sqrt! !!Punto methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 11:51'!conX: unX eY: unY 	x := unX.	y := unY.! !!Punto methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 12:02'!y	^ y! !!Punto methodsFor: 'accessing' stamp: 'SV 8/27/2024 12:01'!x	^ x! !!Punto methodsFor: 'accessing' stamp: 'SV 8/27/2024 11:59'!theta	^ (y/x) arcTan.! !!Punto methodsFor: 'arithmetic' stamp: 'SV 8/27/2024 12:16'!* unPunto 	^ self x * unPunto x + self y * unPunto y! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Punto class	instanceVariableNames: ''!!Punto class methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 12:06'!conRho: unRho yTheta: unTheta 	| punto |	punto := self new.	punto conRho:  unRho yTheta: unTheta. 	^ punto! !!Punto class methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 11:50'!conX: unX eY: unY 	| punto |	punto := self new.	punto conX: unX eY: unY.	^punto! !Object subclass: #Recta	instanceVariableNames: 'pendiente ordenada'	classVariableNames: ''	package: 'PuntosYRectas'!!Recta methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 13:08'!esParalela: unaRecta 	^unaRecta tieneMismaPendiente: pendiente! !!Recta methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 13:59'!distancia: unaRecta 	^unaRecta distanciaConRecta: self! !!Recta methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 13:09'!tieneMismaPendiente: otraPendiente 	^pendiente = otraPendiente ! !!Recta methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 13:09'!esPerpendicular: unaRecta 	^unaRecta tieneMismaPendiente: (-1 / pendiente)! !!Recta methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 14:01'!distanciaConPuntoX: unX eY: unY 	"cuenta magica"	^21! !!Recta methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 13:41'!distanciaConRecta: unaRecta 	(unaRecta esParalela: self) ifFalse: [ ^0 ]. "Simplificacion del modelo"	^((unaRecta ordenada - ordenada)abs)/ (((pendiente ** 2) + 1) sqrt)! !!Recta methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 12:59'!conPendiente: unaPendiente yOrdenadaAlOrigen: unaOrdenada 	pendiente := unaPendiente.	ordenada := unaOrdenada.! !!Recta methodsFor: 'accessing' stamp: 'SV 8/27/2024 12:59'!pendiente	^ pendiente! !!Recta methodsFor: 'accessing' stamp: 'SV 8/27/2024 13:41'!ordenada	^ ordenada! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Recta class	instanceVariableNames: ''!!Recta class methodsFor: 'as yet unclassified' stamp: 'SV 8/27/2024 12:58'!conPendiente: unaPendiente yOrdenadaAlOrigen: unaOrdenada 	| recta |	recta := self new.	recta conPendiente: unaPendiente yOrdenadaAlOrigen: unaOrdenada.	^ recta! !