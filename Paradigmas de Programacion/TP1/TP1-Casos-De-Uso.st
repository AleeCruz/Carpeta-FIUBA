TestCase subclass: #CasosDeUso	instanceVariableNames: 'algunJugador'	classVariableNames: ''	package: 'TP1-Casos-De-Uso'!!CasosDeUso methodsFor: 'tests' stamp: 'AlexanderCruz 4/10/2026 12:56'!test01AgregamosUnJugadorAUnaColeccionYLePedimosSuNombre"Arrange"|equipo unJugador|"act"equipo := { Jugador nombre: 'Paredes' habilidad: 70 cansancio: 90 experiencia: 5 } .unJugador := equipo at:1."Assert"self assert: unJugador nombre  equals: 'Paredes'.! !!CasosDeUso methodsFor: 'tests' stamp: 'AlexanderCruz 4/10/2026 13:03'!test02AgregamosDosJugadoresAUnaColeccion"Arrange"|equipo |"act"equipo := { 	Jugador nombre: 'Paredes' habilidad: 70 cansancio: 90 experiencia: 5 .	Jugador nombre: 'Lautaro' habilidad: 70 cansancio: 50 experiencia: 3.} ."Assert"self assert: equipo size equals: 2.! !!CasosDeUso methodsFor: 'tests' stamp: 'AlexanderCruz 4/10/2026 13:30'!test04SeCreaUnaClaseElegirJugadorRecibeUnaColeccionYDevuelveLaCantidad"Arrange"|equipo eleccion|"act"equipo := { 	Jugador nombre: 'Paredes' habilidad: 70 cansancio: 90 experiencia: 5 .	Jugador nombre: 'Lautaro' habilidad: 70 cansancio: 50 experiencia: 3.	Jugador nombre: 'Julian Alvarez' habilidad: 70 cansancio: 90 experiencia: 3.} .eleccion := ElegirPateador habiendoEmpatadoComo: equipo."Assert"self assert: eleccion cantidadDeJugadores  equals: 3.! !!CasosDeUso methodsFor: 'tests' stamp: 'AlexanderCruz 4/10/2026 20:41'!test07InstanciarUnJugadorConNombreHabilidadCalidadExperienciaYDevuelveSuRendimiento"Arrange"|unJugador|"Act"unJugador := Jugador nombre: 'Paulo Dybala' habilidad: 90 calidad: 0.9 experiencia:  5."Assert"self assert: unJugador decimeTuRendimiento closeTo: 464839.769precision:0.001.! !!CasosDeUso methodsFor: 'tests' stamp: 'AlexanderCruz 4/10/2026 13:48'!test05SeCreaUnaInstanciaDeJugadorYDevuelveSuRendimiento"Arrange"|unJugador |"act"unJugador:= Jugador nombre: 'Lautaro' habilidad: 70 cansancio: 50 experiencia: 3."Assert"self assert: unJugador decimeTuRendimiento equals: 245000.! !!CasosDeUso methodsFor: 'tests' stamp: 'AlexanderCruz 4/10/2026 13:07'!test03AgregamosTresJugadoresAUnaColeccion"Arrange"|equipo |"act"equipo := { 	Jugador nombre: 'Paredes' habilidad: 70 cansancio: 90 experiencia: 5 .	Jugador nombre: 'Lautaro' habilidad: 70 cansancio: 50 experiencia: 3.	Jugador nombre: 'Julian Alvarez' habilidad: 70 cansancio: 90 experiencia: 3.} ."Assert"self assert: equipo size  equals: 3.! !!CasosDeUso methodsFor: 'tests' stamp: 'AlexanderCruz 4/10/2026 14:10'!test06DadoUnaColeccionDeJugadoresDebemosElegirAlQueTengaMejorRendimiento"Arrange"|equipo eleccion unJugador |"act"equipo:= {	Jugador nombre: 'Lautaro' habilidad: 70 cansancio: 50 experiencia: 3.	Jugador nombre: 'Angel Di Maria' habilidad: 81 cansancio: 70 experiencia: 6.	Jugador nombre: 'Paredes' habilidad: 70 cansancio: 90 experiencia: 5 }.eleccion := ElegirPateador habiendoEmpatadoComo: equipo.unJugador := eleccion mejorPateador ."Assert"self assert:  unJugador decimeTuRendimiento  equals: 459270.! !