Object subclass: #ElegirPateador	instanceVariableNames: 'jugadores'	classVariableNames: ''	package: 'TP1'!!ElegirPateador methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/10/2026 13:29'!cantidadDeJugadores	^ (jugadores size ) deepCopy .! !!ElegirPateador methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/10/2026 13:31'!habiendoEmpatadoComo: unEquipoColeccion 	jugadores := unEquipoColeccion .	^ jugadores deepCopy.! !!ElegirPateador methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/10/2026 14:08'!mejorPateador	|mejorPateador |		mejorPateador := jugadores detectMax:  [ :algunJugador| algunJugador decimeTuRendimiento  ].	^ mejorPateador.! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ElegirPateador class	instanceVariableNames: ''!!ElegirPateador class methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/10/2026 13:28'!habiendoEmpatadoComo: unEquipoColeccion 	|instanciaElegirPateador|	instanciaElegirPateador := self new.		instanciaElegirPateador habiendoEmpatadoComo: unEquipoColeccion.		^ instanciaElegirPateador .	! !Object subclass: #Jugador	instanceVariableNames: 'nombre habilidad cansancio experiencia calidad'	classVariableNames: ''	package: 'TP1'!!Jugador methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/10/2026 20:54'!nombre: unNombre habilidad: unValHabilidad calidad: unValCalidad experiencia: unValExperiencia 	nombre := unNombre .	habilidad := unValHabilidad.	cansancio :=0.	calidad:= unValCalidad .	experiencia := unValExperiencia .! !!Jugador methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/10/2026 20:55'!nombre: unNombre habilidad: unValorHabilidad cansancio: unValorCansancio experiencia: unValorExperiencia nombre := unNombre .habilidad := unValorHabilidad .calidad := 0.cansancio := unValorCansancio .experiencia := unValorExperiencia . ! !!Jugador methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/10/2026 20:57'!decimeTuRendimiento	(cansancio =0) ifTrue: [ ^ (habilidad ** (2+calidad))].	(calidad =0) ifTrue: [ ^ ((habilidad **2)*cansancio ) ]! !!Jugador methodsFor: 'accessing' stamp: 'AlexanderCruz 4/10/2026 12:56'!nombre	^ nombre deepCopy .! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Jugador class	instanceVariableNames: ''!!Jugador class methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/10/2026 20:22'!nombre: unNombre habilidad: unValHabilidad calidad: unValCalidad experiencia: unValExperiencia 	|unJugador|	unJugador := self new.	unJugador nombre: unNombre habilidad: unValHabilidad calidad: unValCalidad experiencia: unValExperiencia.	^ unJugador ! !!Jugador class methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/10/2026 12:48'!nombre: unNombre habilidad: unValorHabilidad cansancio: unValorCansancio experiencia: unValorExperiencia 	|unJugador|	unJugador := self new.	unJugador nombre: unNombre habilidad: unValorHabilidad cansancio: unValorCansancio experiencia: unValorExperiencia .	^ unJugador .! !