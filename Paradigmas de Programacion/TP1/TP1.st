Object subclass: #AlgoConsejo	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!AlgoConsejo class	instanceVariableNames: 'criterio futbolistas conmebolPaises'!!AlgoConsejo class methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 21:12'!registrarFutbolistaConNombre: unNombreFutbolista dePeso: unPeso yAltura: unaAltura yEdad: unaEdad yProvenienteDelClub: unClub DePais: unPais	|unFutbolista|	('Argentina' = unPais ) 		ifTrue: [			unFutbolista := Futbolista_Argentino new.		]		ifFalse: [			(conmebolPaises includes: unPais)				ifTrue: [					unFutbolista := Futbolista_Conmebol new.				]				ifFalse: [					(unaEdad > 33) 						ifTrue: [ unFutbolista := Futbolista_Extranjero_Mayor new ]						ifFalse: [ unFutbolista := Futbolista_Extranjero new ].				].		].	unFutbolista asignarNombre: unNombreFutbolista.	unFutbolista asignarPeso: unPeso.	unFutbolista asignarAltura: unaAltura.	unFutbolista asignarEdad: unaEdad.	unFutbolista asignarClub: unClub.	unFutbolista asignarPais: unPais.	unFutbolista aignarCriterio: criterio .	futbolistas add: unFutbolista.! !!AlgoConsejo class methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 23:29'!obtenerFutbolistaSegunCriterio	| resultado seleccionados |	(criterio ='Caro' ) ifTrue: [		seleccionados := futbolistas select: [ :f | (f dameTuCriterio) = 'Caro' ].		resultado := seleccionados detectMax: [ :f | f dameTuValorEnPesos ].	]	ifFalse: [		seleccionados := futbolistas select: [ :f | (f dameTuCriterio) = 'Barato' ].		resultado := seleccionados detectMin: [ :f | f dameTuValorEnPesos ].	].		^ resultado dameTuNombre.! !!AlgoConsejo class methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 13:43'!valorDe: unNombreFutbolista|unFutbolista valor |valor := Valor new.unFutbolista := futbolistas detect: [ :futbolista | (futbolista dameTuNombre ) = unNombreFutbolista].valor asignarResultado: (unFutbolista dameTuValorEnPesos).^ valor .	! !!AlgoConsejo class methodsFor: 'accessing' stamp: 'Alexander 9/25/2025 23:14'!futbolistas: unaColeccion	futbolistas := unaColeccion .! !!AlgoConsejo class methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 22:09'!asignarCriterio: unCriterio	criterio := unCriterio  	! !!AlgoConsejo class methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 14:36'!conCriterioMas: unCriterio	criterio := unCriterio.	futbolistas := OrderedCollection new.	conmebolPaises :=OrderedCollection new.		conmebolPaises add: 'Bolivia'.	conmebolPaises add: 'Brasil'.	conmebolPaises add: 'Chile'.	conmebolPaises add: 'Colombia'.	conmebolPaises add: 'Ecuador'.	conmebolPaises add: 'Paraguay'.	conmebolPaises add: 'Perú'.	conmebolPaises add: 'Uruguay'.	conmebolPaises add: 'Venezuela'.	! !Object subclass: #Futbolista_Argentino	instanceVariableNames: 'nombre peso altura edad club pais criterio valorEnPesos valorEnReales'	classVariableNames: ''	package: 'TP1'!!Futbolista_Argentino methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 11:35'!asignarClub: unClub	club := unClub . 	! !!Futbolista_Argentino methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 11:31'!asignarNombre: unNombre 	nombre := unNombre . ! !!Futbolista_Argentino methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 11:32'!asignarPeso: unPeso 	peso := unPeso.! !!Futbolista_Argentino methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 11:34'!asignarAltura: unaAltura	altura := unaAltura . 	! !!Futbolista_Argentino methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 11:36'!asignarPais: unPais	pais := unPais . 	! !!Futbolista_Argentino methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 13:47'!aignarCriterio: unCriterio	criterio := unCriterio . 	! !!Futbolista_Argentino methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 11:34'!asignarEdad: unaEdad	edad := unaEdad .	 	! !!Futbolista_Argentino methodsFor: 'accessing' stamp: 'Alexander 9/25/2025 23:23'!nombre	^ nombre! !!Futbolista_Argentino methodsFor: 'initialization' stamp: 'Alexander 9/25/2025 10:22'!initialize 	nombre := 'UnNombreDeJugador'.	peso := 80.	altura := 1.54.	edad := 25.	club := 'AlgunClubDeFutbol'.	pais := 'AlgunPais'.	criterio := 'AlgunCriterioCaroBarato'.	! !!Futbolista_Argentino methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 22:24'!dameTuCriterio	^ criterio .! !!Futbolista_Argentino methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 21:23'!dameTuValorEnPesos				valorEnPesos := (((peso * altura )/ edad)*1.10).			^ valorEnPesos.! !!Futbolista_Argentino methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 23:31'!dameTuNombre	^nombre ! !Object subclass: #Futbolista_Conmebol	instanceVariableNames: 'nombre peso altura edad club pais criterio valorEnPesos valorEnReales'	classVariableNames: ''	package: 'TP1'!!Futbolista_Conmebol methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 22:25'!dameTuCriterio	^ criterio ! !!Futbolista_Conmebol methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 21:24'!dameTuValorEnPesos	valorEnPesos := (((peso * altura )/ edad)*1.25).	^ valorEnPesos .! !!Futbolista_Conmebol methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 14:45'!dameTuNombre	^ nombre ! !!Futbolista_Conmebol methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 14:45'!asignarClub: unClub	club := unClub . 	! !!Futbolista_Conmebol methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 14:45'!asignarNombre: unNombre 	nombre := unNombre . ! !!Futbolista_Conmebol methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 14:45'!asignarPeso: unPeso 	peso := unPeso.! !!Futbolista_Conmebol methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 14:45'!asignarAltura: unaAltura	altura := unaAltura . 	! !!Futbolista_Conmebol methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 14:45'!asignarPais: unPais	pais := unPais . 	! !!Futbolista_Conmebol methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 14:45'!aignarCriterio: unCriterio	criterio := unCriterio . 	! !!Futbolista_Conmebol methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 14:45'!asignarEdad: unaEdad	edad := unaEdad .	 	! !!Futbolista_Conmebol methodsFor: 'initialization' stamp: 'Alexander 9/25/2025 14:45'!initialize 	nombre := 'UnNombreDeJugador'.	peso := 80.	altura := 1.54.	edad := 25.	club := 'AlgunClubDeFutbol'.	pais := 'AlgunPais'.	criterio := 'AlgunCriterioCaroBarato'.	! !Object subclass: #Futbolista_Extranjero	instanceVariableNames: 'nombre peso altura edad club pais criterio valorEnPesos valorEnReales'	classVariableNames: ''	package: 'TP1'!!Futbolista_Extranjero methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 14:56'!asignarClub: unClub	club := unClub . 	! !!Futbolista_Extranjero methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 14:56'!asignarNombre: unNombre 	nombre := unNombre . ! !!Futbolista_Extranjero methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 14:56'!asignarPeso: unPeso 	peso := unPeso.! !!Futbolista_Extranjero methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 14:56'!asignarAltura: unaAltura	altura := unaAltura . 	! !!Futbolista_Extranjero methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 14:56'!asignarPais: unPais	pais := unPais . 	! !!Futbolista_Extranjero methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 14:56'!aignarCriterio: unCriterio	criterio := unCriterio . 	! !!Futbolista_Extranjero methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 14:56'!asignarEdad: unaEdad	edad := unaEdad .	 	! !!Futbolista_Extranjero methodsFor: 'initialization' stamp: 'Alexander 9/25/2025 14:56'!initialize 	nombre := 'UnNombreDeJugador'.	peso := 80.	altura := 1.54.	edad := 25.	club := 'AlgunClubDeFutbol'.	pais := 'AlgunPais'.	criterio := 'AlgunCriterioCaroBarato'.	! !!Futbolista_Extranjero methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 21:25'!dameTuValorEnPesos	valorEnPesos := (((peso * altura )/ edad)*1.50).	^ valorEnPesos .! !!Futbolista_Extranjero methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 15:20'!dameTuCriterio	^ criterio ! !!Futbolista_Extranjero methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 14:56'!dameTuNombre	^ nombre ! !Object subclass: #Futbolista_Extranjero_Mayor	instanceVariableNames: 'nombre peso altura edad club pais criterio valorEnPesos valorEnReales'	classVariableNames: ''	package: 'TP1'!!Futbolista_Extranjero_Mayor methodsFor: 'initialization' stamp: 'Alexander 9/25/2025 15:38'!initialize 	nombre := 'UnNombreDeJugador'.	peso := 80.	altura := 1.54.	edad := 25.	club := 'AlgunClubDeFutbol'.	pais := 'AlgunPais'.	criterio := 'AlgunCriterioCaroBarato'.	! !!Futbolista_Extranjero_Mayor methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 15:38'!asignarClub: unClub	club := unClub . 	! !!Futbolista_Extranjero_Mayor methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 15:38'!asignarNombre: unNombre 	nombre := unNombre . ! !!Futbolista_Extranjero_Mayor methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 15:38'!asignarPeso: unPeso 	peso := unPeso.! !!Futbolista_Extranjero_Mayor methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 15:38'!asignarAltura: unaAltura	altura := unaAltura . 	! !!Futbolista_Extranjero_Mayor methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 15:38'!asignarPais: unPais	pais := unPais . 	! !!Futbolista_Extranjero_Mayor methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 15:38'!aignarCriterio: unCriterio	criterio := unCriterio . 	! !!Futbolista_Extranjero_Mayor methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 15:38'!asignarEdad: unaEdad	edad := unaEdad .	 	! !!Futbolista_Extranjero_Mayor methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 21:14'!dameTuValorEnPesos	valorEnPesos := (((100 * peso * (altura sqrt )) / (edad raisedTo: 3))*1.5).	^ valorEnPesos.! !!Futbolista_Extranjero_Mayor methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 15:38'!dameTuCriterio	^ criterio ! !!Futbolista_Extranjero_Mayor methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 15:38'!dameTuNombre	^ nombre ! !Object subclass: #Valor	instanceVariableNames: 'resultado'	classVariableNames: ''	package: 'TP1'!!Valor methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 21:46'!compararConValorEnReales: unValoRealEsperado precision: unaPresicion 	| diferencia |	resultado := ((resultado)/245).	diferencia := (resultado - unValoRealEsperado) abs.	^ diferencia < unaPresicion.! !!Valor methodsFor: 'not defined category' stamp: 'Alexander 9/25/2025 21:45'!compararCon: unValorEsperado precision: unaPresicion	| diferencia |	diferencia := (resultado - unValorEsperado) abs.	^ (diferencia < unaPresicion).! !!Valor methodsFor: 'as yet unclassified' stamp: 'Alexander 9/25/2025 13:43'!asignarResultado: unResultado	resultado := unResultado . ! !