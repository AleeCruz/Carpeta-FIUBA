TestCase subclass: #AlgoPenalesTest	instanceVariableNames: 'precision'	classVariableNames: ''	package: 'TP1-Tests'!!AlgoPenalesTest methodsFor: 'tests' stamp: 'DS 4/7/2026 20:03'!test02EntreDosJugadoresTitularesDeMismaHabilidadYMismaExperienciaPateaElMenosCansado	| jugadorEsperado jugadorAPatear eleccion  equipo |		"Arrange"	equipo := { 					Jugador nombre: 'Lautaro' habilidad: 70 cansancio: 50 experiencia: 3.					Jugador nombre: 'Julian Alvarez' habilidad: 70 cansancio: 90 experiencia: 3.									}.	eleccion := ElegirPateador habiendoEmpatadoComo: equipo. "Inicialmente el partido esta 0-0"		"Act"	jugadorAPatear := eleccion mejorPateador.	"	Queremos elegir un jugador que seguro patee bien, 	por lo que pateará el que obtenga	un mayor resultado analizando su habilidad al cuadrado multiplicado por su cansancio	"		"Assert"	jugadorEsperado := 'Julian Alvarez'.	self assert: jugadorAPatear nombre equals: jugadorEsperado		"	Valoración de Julian: 70^2 * 90 = 441,000.	Valoración de Lautaro: 70^2 * 50 = 245,000"! !!AlgoPenalesTest methodsFor: 'tests' stamp: 'DS 3/21/2026 21:17'!test03EntreDosJugadoresTitularesDeDistintaHabilidadPeroCiertoCansancioPateaElIndicado	| jugadorEsperado jugadorAPatear eleccion  equipo |		"Arrange"	equipo := { 		Jugador nombre: 'Lionel Messi' habilidad: 90 cansancio: 20 experiencia: 7.		Jugador nombre: 'Angel Di Maria' habilidad: 81 cansancio: 70 experiencia: 6. 	}.	eleccion := ElegirPateador habiendoEmpatadoComo: equipo . "Inicialmente el partido esta 0-0"		"Act"		jugadorAPatear := eleccion mejorPateador.		"Assert"	jugadorEsperado := 'Angel Di Maria'.	self assert: jugadorAPatear nombre equals: jugadorEsperado	"	Valoración de Lionel: 90^2 * 20 = 162,000.	Valoración de Angel: 81^2 * 70 = 459,270"! !!AlgoPenalesTest methodsFor: 'tests' stamp: 'DS 3/21/2026 22:11'!test06SiElEquipoEstaGanandoElPartidoELJugadorEstaMasConfiadoParaPatear	"Arrange"	| jugadorEsperado eleccion jugadorAPatear equipo |	equipo := {		Jugador nombre: 'Guido Rodriguez' habilidad: 60 cansancio: 50 experiencia: 2.		Jugador nombre: 'Dibu Martinez' habilidad: 20 cansancio: 70 experiencia: 5.		Jugador nombre: 'Paulo Dybala' habilidad: 90 calidad: 0.1 experiencia: 5. 	}.	eleccion := ElegirPateador habiendoGanadoComo: equipo .	"Argentina toma la ventaja. Se incrementá en 80,000 la evaluación de los suplentes"		"Act"		jugadorAPatear := eleccion mejorPateador.		"Assert"	jugadorEsperado := 'Paulo Dybala'.	self assert: jugadorAPatear nombre equals: jugadorEsperado	"	Valoración de Dibu:  20^2 * 70      = 28,000.	Valoración de Guido: (60^2 * 50)/2  = 90,000.	Valoración de Pablo: 90^(2 + .1)    = 12,703.08692273562 + 80,000 de Plus.	Guido patea el penal debido a que 20^2 * 70 + 1000 < (60^2 * 50)/2 + 1000"! !!AlgoPenalesTest methodsFor: 'tests' stamp: 'DS 3/21/2026 21:17'!test01UnJugadorConCiertoCansancioYCiertaHabilidadEsElEncargadoDePatearElPenal			| jugadorEsperado jugadorAPatear eleccion  equipo |		"Arrange"	equipo := { Jugador nombre: 'Paredes' habilidad: 70 cansancio: 90 experiencia: 5 } .	eleccion := ElegirPateador habiendoEmpatadoComo: equipo.	"Inicialmente el partido esta 0-0"			"Act"		jugadorAPatear := eleccion mejorPateador.		"Assert"	jugadorEsperado := 'Paredes'.	self assert: jugadorAPatear nombre equals: jugadorEsperado.! !!AlgoPenalesTest methodsFor: 'tests' stamp: 'DS 3/21/2026 21:49'!test04EntreUnJugadorTitularYUnoQueEntroDeSuplentePateaElIndicado	| jugadorEsperado jugadorAPatear eleccion  equipo |		"Arrange"	equipo := { 		"Suplente nombre: 'Paulo Dybala' habilidad: 90 calidad: 0.9 experiencia:  5."		Jugador nombre: 'Paulo Dybala' habilidad: 90 calidad: 0.9 experiencia:  5.		Jugador nombre: 'Angel Di Maria' habilidad: 81 cansancio: 70 experiencia: 5.	}.	eleccion := ElegirPateador habiendoEmpatadoComo: equipo. "Inicialmente el partido esta 0-0"	"Act"		jugadorAPatear := eleccion mejorPateador.		"Assert"	jugadorEsperado := 'Paulo Dybala'.	self assert: jugadorAPatear nombre equals: jugadorEsperado	"	Si el jugador tiene calidad de suplente, 	no se lo puede evaluar de la misma manera que a los titulares, 	por lo que para ver si va a patear se evaluará su habilidad 	elevado a dos más su calidad de suplente	Valoración de Dybala: 90^(2 + 0.9) = 464,839.7697280635	Valoración de Angel:  81^2 * 70    = 459,270	"! !!AlgoPenalesTest methodsFor: 'tests' stamp: 'DS 3/21/2026 21:16'!test07SiElEquipoEstaPerdiendoElJugadorEstaMasNerviosoParaPatear	"Arrange"	| jugadorEsperado eleccion jugadorAPatear equipo |	equipo := { 		Jugador nombre: 'Dario Benedetto' habilidad: 78 cansancio: 80 experiencia: 15.		Jugador nombre: 'Leandro Paredes' habilidad: 78 cansancio: 75 experiencia: 5.	}.	eleccion := ElegirPateador habiendoPerdidoComo: equipo.	"	Argentina cae ante Portugal. 	Al cansancio de los jugadores se les resta la experiencia.	"	"Act"		jugadorAPatear := eleccion mejorPateador.		"Assert"	jugadorEsperado := 'Leandro Paredes'.	self assert: jugadorAPatear nombre equals: jugadorEsperado	"	Valuación de Benedetto: 78^2 * (80 - 15) = 395,460 	Valuación de Paredes:   78^2 * (75 - 5) =  425,880 	Benedetto patea el penal debido a que 89^2 * 20 - 1000 < 78^2 * 80 - 1000"! !!AlgoPenalesTest methodsFor: 'tests' stamp: 'DS 3/21/2026 21:16'!test05EntreUnJugadorExperimentadoYUnoSinExperienciaDeMismaTitularidadPateaElIndicado	"Arrange"	| jugadorEsperado eleccion jugadorAPatear equipo |	equipo := { 		Jugador nombre: 'Guido Rodriguez' habilidad: 60 cansancio: 50 experiencia: 2.		"		Un jugador con menos de 3 anios de experiencia no es experimentado, 		por lo que para evaluar si puede patear, 		deberá hacerse el mismo cálculo que para los demás jugadores 		pero dividiendo el total por dos		"		Jugador nombre: 'Nicolas Otamendi' habilidad: 40 cansancio: 70 experiencia: 5. 	}.	eleccion := ElegirPateador habiendoEmpatadoComo: equipo. "Inicialmente el partido esta 0-0"		"Act"		jugadorAPatear := eleccion mejorPateador.		"Assert"	jugadorEsperado := 'Nicolas Otamendi'.	self assert: jugadorAPatear nombre equals: jugadorEsperado	"Guido patea el penal debido a que 40^2 * 70 > (60^2 * 50)/2"! !TestCase subclass: #CasosDeUso	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 5/14/2026 12:31'!test20SeAgreganUnJugadorTitularConExperienciaInvalida      "Arrange"	|unJugador|    "Act"   unJugador :=     "Assert"    self should: [Jugador nombre: 'Dibu' habilidad: 2 cansancio: 3 experiencia: -3.] raise: ExperienciaInvalida   .	! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 4/22/2026 00:51'!test12UnJugadorTitularSeleccionadoReduciraSuCansancio"Arrange"|equipo eleccion unJugadorAPatear|"Act"equipo := { Jugador nombre: 'Guido Rodriguez' habilidad: 20 cansancio: 20 experiencia: 2. Jugador nombre: 'Paredes' habilidad: 70 cansancio: 90 experiencia: 5 . }.eleccion := ElegirPateador habiendoEmpatadoComo: equipo.unJugadorAPatear := eleccion mejorPateador .unJugadorAPatear reducirCansancio ."Assert"self assert:   unJugadorAPatear cansancio  equals: 85  .! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 5/14/2026 12:40'!test18SeAgreganUnJugadorSuplenteConCalidadInvalida    "Arrange"	|unJugador|	"Act"	unJugador := [Jugador nombre: 'Paulo Dybala' habilidad:90 calidad:-2  experiencia: 5].    "Assert"    self should: unJugador  raise: CalidadInvalida .! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 4/22/2026 00:41'!test09DadoUnJugadorSuplentePreguntarSiTieneCalidad"Arrange"|equipo |"Act"equipo := { Jugador nombre: 'Guido Rodriguez' habilidad: 60 cansancio: 50 experiencia: 2. Jugador nombre: 'Paulo Dybala' habilidad: 90 calidad: 0.9 experiencia:  5.Jugador nombre: 'Paredes' habilidad: 70 cansancio: 90 experiencia: 5 . }."Assert"self assert: (equipo at:2) tienesCalidad equals: true .! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 4/2