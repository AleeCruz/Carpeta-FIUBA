Object subclass: #AlgoTek	instanceVariableNames: 'eventos'	classVariableNames: ''	package: 'TP1'!!AlgoTek methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 15:49'!costoEntradaPara: unNombreEvento enUbicacion: unNombreUbicacion pagandoCon: unMedioDePago |unEvento|unEvento := self buscarEventoLlamado: unNombreEvento .^ unEvento calcularEntradaDe: unNombreUbicacion con: unMedioDePago! !!AlgoTek methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 19:01'!entradaMasBarataPara: unNombreDeEvento pagandoCon: unMedioDEPago 	|unEvento|	unEvento := self buscarEventoLlamado: unNombreDeEvento .	^ unEvento entradaMasBarataPagandoCon: unMedioDEPago .! !!AlgoTek methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 16:38'!cantidadDeUbicacionesRegistradasPara: unNomBreDeEvento 	|unEvento|	unEvento := self buscarEventoLlamado: unNomBreDeEvento .	^ unEvento cantidadDeUbicaciones.! !!AlgoTek methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 13:20'!cantidadDeEvento	^eventos size.! !!AlgoTek methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 15:48'!paraEvento: unNombreDeEvento registrarUbicacionViP: unaUbicacion tarifa: unaTarifa lugaresDisponibles: unaCantidadDeLugares |unEvento|unEvento  := self buscarEventoLlamado: unNombreDeEvento .	unEvento  paraEvento: unNombreDeEvento registrarUbicacionViP: unaUbicacion tarifa: unaTarifa lugaresDisponibles: unaCantidadDeLugares .! !!AlgoTek methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 15:46'!buscarEventoLlamado: unNombreEvento 		 | unEvento |unEvento := eventos detect: [ :evento| evento conNombre: unNombreEvento ].	^ unEvento.! !!AlgoTek methodsFor: 'as yet unclassified' stamp: 'Alexander 9/24/2026 11:58'!registrarEvento: unNombreDeEvento deArtistaNacional: unNombreDeArtistaNacional conTarifaArtista: unaTarifa eventos add: (Evento deNombre: unNombreDeEvento conUnArtistaNacional: unNombreDeArtistaNacional deTarifa: unaTarifa ).! !!AlgoTek methodsFor: 'as yet unclassified' stamp: 'Alexander 9/24/2026 15:47'!paraEvento: unNombreDeEvento registrarUbicacionCampo: unNombreDeUbicacion tarifa: unaTarifaParaLaUbicacion | unEvento |unEvento := self buscarEventoLlamado: unNombreDeEvento . unEvento paraEvento: unNombreDeEvento registrarUbicacionCampo: unNombreDeUbicacion tarifa: unaTarifaParaLaUbicacion.! !!AlgoTek methodsFor: 'as yet unclassified' stamp: 'Alexander 9/24/2026 12:05'!registrarEvento: unNombreDeEvento deArtistaInternacional: unNombreDeArtistaInternacional conTarifaArtista: unaTarifa eventos add: ( Evento deNombre: unNombreDeEvento conUnArtistaInternacional: unNombreDeArtistaInternacional deTarifa: unaTarifa ).! !!AlgoTek methodsFor: 'as yet unclassified' stamp: 'Alexander 9/24/2026 15:45'!paraEvento: unNombreDeEvento registrarUbicacionPlateaPreferencial: unNombreDeUbicacion tarifa: unaTarifaParaLaUbicacion |unEvento|unEvento := self buscarEventoLlamado: unNombreDeEvento .unEvento paraEvento: unNombreDeEvento registrarUbicacionPlateaPreferencial: unNombreDeUbicacion tarifa: unaTarifaParaLaUbicacion.! !!AlgoTek methodsFor: 'initialization' stamp: 'Alexander 9/24/2026 11:56'!initialize super initialize .eventos := OrderedCollection new.! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!AlgoTek class	instanceVariableNames: ''!!AlgoTek class methodsFor: 'not defined category' stamp: 'Alexander 9/23/2026 11:51'!registrarEvento: unEvento deArtistaNacional: unArtista conTarifaArtista: unaTarifa 	^self new registrarEvento: unEvento deArtistaNacional: unArtista conTarifaArtista: unaTarifa! !!AlgoTek class methodsFor: 'not defined category' stamp: 'Alexander 9/23/2026 16:25'!registrarEvento: unEvento deArtistaInternacional: unNombreDeArtista conTarifaArtista: unaTarifa 	^self new registrarEvento: unEvento deArtistaInternacional: unNombreDeArtista conTarifaArtista: unaTarifa! !Object subclass: #Artista	instanceVariableNames: 'nombre tarifaArtista'	classVariableNames: ''	package: 'TP1'!!Artista methodsFor: 'initialization' stamp: 'Alexander 9/24/2026 16:23'!initialize nombre := 'Sin Nombre'.tarifaArtista := 0.! !!Artista methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 12:15'!calcularCosto 	self subclassResponsibility .! !!Artista methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 21:31'!conNombre: unNombreDeArtista conTarifaDe: unaTarifa(unaTarifa <0 ) ifTrue: [ ErrorTarifaDelArtistaInvalido signal ].nombre := unNombreDeArtista .tarifaArtista  := unaTarifa .! !Error subclass: #ErrorInvalido	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!ErrorInvalido subclass: #ErrorCantidadDeLugaresDisponibles	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!ErrorInvalido subclass: #ErrorTarifaDeUbicacionInvalido	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!ErrorInvalido subclass: #ErrorTarifaDelArtistaInvalido	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!Object subclass: #Evento	instanceVariableNames: 'nombreDelEvento artistas ubicaciones'	classVariableNames: ''	package: 'TP1'!!Evento methodsFor: 'as yet unclassified' stamp: 'Alexander 9/23/2026 16:57'!registraUnArtistaNacionalDeNombre: unNombreDeArtista conUnaTarifaDe: unaTarifa 	|unArtista|	unArtista := Nacional conNombre: unNombreDeArtista conTarifaDe: unaTarifa .	artistas add: unArtista .! !!Evento methodsFor: 'as yet unclassified' stamp: 'Alexander 9/24/2026 00:01'!deNombre: unNombreDeEvento conUnArtistaInternacional: unNombreArtistaInternacional deTarifa: unaTarifa 	nombreDelEvento := unNombreDeEvento .	artistas add: (Internacional conNombre: unNombreArtistaInternacional conTarifaDe: unaTarifa ).! !!Evento methodsFor: 'as yet unclassified' stamp: 'Alexander 9/23/2026 20:17'!deNombre: unNombreDelEvento conUnArtistaNacional: unNombreArtistaNacional deTarifa: unaTarifa 	nombreDelEvento := unNombreDelEvento .	artistas add:( Nacional conNombre: unNombreArtistaNacional  conTarifaDe: unaTarifa  ).! !!Evento methodsFor: 'as yet unclassified' stamp: 'Alexander 9/24/2026 16:38'!registraUnArtistaInteracionalDeNombre: unNombreDeArtista conUnaTarifaDe: unaTarifa 	|unArtista|	unArtista := Internacional conNombre: unNombreDeArtista  conTarifaDe: unaTarifa .	artistas add: unArtista . ! !!Evento methodsFor: 'not defined category' stamp: 'Alexander 9/23/2026 22:03'!decimeLaCantidadDeArtistas	^artistas size.! !!Evento methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 12:46'!conNombre: unNombreDeEvento 	^ nombreDelEvento = unNombreDeEvento ! !!Evento methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 13:52'!paraEvento: unNombreDeEvento registrarUbicacionCampo: unNombreDeUbicacion tarifa: unaTarifaDeUbicacion			ubicaciones add: (Campo conLugarEn: unNombreDeUbicacion yUnaTarifaDe: unaTarifaDeUbicacion).! !!Evento methodsFor: 'not defined category' stamp: 'Alexander 9/23/2026 21:37'!artista	^ (artistas at: 1).! !!Evento methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 13:25'!cantidadDeUbicaciones	^ubicaciones size.! !!Evento methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 17:14'!entradaMasBarataPagandoCon: unMedioDePago 	|tarifaMinima|	tarifaMinima := (ubicaciones collect: [ :ubicacion | ubicacion calcularPrecio ]) min.	^ ((artistas at: 1) calcularCosto) + tarifaMinima.! !!Evento methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 13:59'!paraEvento: unNombreDeEvento registrarUbicacionPlateaPreferencial: unNombreDeUbicacion tarifa: unaTarifaDeUbicacion  		ubicaciones add: (Platea conLugarEn: unNombreDeUbicacion yUnaTarifaDe: unaTarifaDeUbicacion) .! !!Evento methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 17:14'!calcularEntradaDe: unNombreDeUbicacion con: unMedioDePago 	|unaUbicacion costoBase|	unaUbicacion := ubicaciones detect: [ :ubicacion | ubicacion conNombre: unNombreDeUbicacion ].	costoBase := ((artistas at: 1) calcularCosto) + (unaUbicacion calcularPrecio).	^ unMedioDePago obtenerBeneficio: costoBase.! !!Evento methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 13:58'!paraEvento: unNombreDeEvento registrarUbicacionViP: unNombreDeUbicacion tarifa: unaTarifa lugaresDisponibles: cantidadDeLugaresDisponibles  		ubicaciones add: (Vip conLugarEn: unNombreDeUbicacion 									 yUnaTarifaDe: unaTarifa									 lugaresDisponibles: cantidadDeLugaresDisponibles )	! !!Evento methodsFor: 'initialization' stamp: 'Alexander 9/24/2026 17:18'!initialize 	nombreDelEvento := 'Sin Nombre Del Evento'.	artistas := OrderedCollection new.	ubicaciones := OrderedCollection new.	! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Evento class	instanceVariableNames: ''!!Evento class methodsFor: 'not defined category' stamp: 'Alexander 9/23/2026 23:59'!deNombre: unNombreDeEvento conUnArtistaInternacional: unNombreArtistaInternacional deTarifa: unaTarifa 	^self new deNombre: unNombreDeEvento conUnArtistaInternacional: unNombreArtistaInternacional deTarifa: unaTarifa 	! !!Evento class methodsFor: 'not defined category' stamp: 'Alexander 9/23/2026 16:14'!registraUnArtistaNacionalDeNombre: unNombreDeArtista conUnaTarifaDe: unaTarifaDeArtista 	^ self new registraUnArtistaNacionalDeNombre: unNombreDeArtista conUnaTarifaDe: unaTarifaDeArtista! !!Evento class methodsFor: 'not defined category' stamp: 'Alexander 9/23/2026 20:15'!deNombre: unNombreDelEvento conUnArtistaNacional: unNombreDeArtista deTarifa: unaTarifa 	^self new deNombre: unNombreDelEvento conUnArtistaNacional: unNombreDeArtista deTarifa: unaTarifa.	! !!Evento class methodsFor: 'not defined category' stamp: 'Alexander 9/23/2026 16:18'!registraUnArtistaInteracionalDeNombre: unNombreDeArtista conUnaTarifaDe: unaTarifa 	^ self new registraUnArtistaInteracionalDeNombre: unNombreDeArtista conUnaTarifaDe: unaTarifa! !Artista subclass: #Internacional	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Internacional methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 16:25'!calcularCosto	^ ((tarifaArtista  * 2) / 5 + 1000)! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Internacional class	instanceVariableNames: ''!!Internacional class methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 00:09'!conNombre: unNombreArtistaInternacional conTarifaDe: unatarifa 	^self new conNombre: unNombreArtistaInternacional conTarifaDe: unatarifa .! !Object subclass: #MedioDePago	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!MedioDePago methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 15:52'!obtenerBeneficio: precioDeEntrada	self subclassResponsibility .! !MedioDePago subclass: #Efectivo	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Efectivo methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 00:33'!obtenerBeneficio: precioDeEntrada	^ precioDeEntrada .! !Artista subclass: #Nacional	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Nacional methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 16:24'!calcularCosto	^ tarifaArtista log.! !!Nacional methodsFor: 'initialization' stamp: 'Alexander 9/24/2026 16:24'!initialize 	super initialize.! !!Nacional methodsFor: 'accessing' stamp: 'Alexander 9/23/2026 20:20'!nombre	^ nombre! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Nacional class	instanceVariableNames: ''!!Nacional class methodsFor: 'not defined category' stamp: 'Alexander 9/23/2026 16:11'!conNombre: unNombreDeArtista conTarifaDe: unaTarifa 	^self new conNombre: unNombreDeArtista conTarifaDe: unaTarifa! !MedioDePago subclass: #Tarjeta	instanceVariableNames: 'nombre beneficio'	classVariableNames: ''	package: 'TP1'!!Tarjeta methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 00:32'!obtenerBeneficio: precioDeEntrada^ precioDeEntrada * beneficio .! !!Tarjeta methodsFor: 'as yet unclassified' stamp: 'Alexander 9/24/2026 00:31'!conNombre: unNombre 	nombre := unNombre .	beneficio := 0.8.! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Tarjeta class	instanceVariableNames: ''!!Tarjeta class methodsFor: 'not defined category' stamp: 'Alexander 9/23/2026 16:29'!conNombre: unNombre 	^self new conNombre: unNombre .! !Object subclass: #Ubicacion	instanceVariableNames: 'nombre tarifaUbicacion'	classVariableNames: ''	package: 'TP1'!!Ubicacion methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 22:33'!conLugarEn: unNombreDeLugar yUnaTarifaDe: unaTarifaDelLugar 	(unaTarifaDelLugar <0)ifTrue: [ ErrorTarifaDeUbicacionInvalido signal ].	nombre:= unNombreDeLugar .	tarifaUbicacion:=unaTarifaDelLugar .! !!Ubicacion methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 15:34'!conNombre: unNombreDeUbicacion 	^ nombre sameAs: unNombreDeUbicacion ! !!Ubicacion methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 15:35'!calcularPrecio 	self subclassResponsibility .! !!Ubicacion methodsFor: 'initialization' stamp: 'Alexander 9/24/2026 15:32'!initialize 	nombre := 'Sin Nombre'.	tarifaUbicacion :=0.! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Ubicacion class	instanceVariableNames: ''!!Ubicacion class methodsFor: 'not defined category' stamp: 'Alexander 9/23/2026 16:49'!conLugarEn: unNombreDelLugar yUnaTarifaDe: unaTarifa 	^self new conLugarEn: unNombreDelLugar yUnaTarifaDe: unaTarifa.! !Ubicacion subclass: #Campo	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Campo methodsFor: 'initialization' stamp: 'Alexander 9/24/2026 15:31'!initialize 	super initialize .! !!Campo methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 15:28'!calcularPrecio	^ tarifaUbicacion .! !Ubicacion subclass: #Platea	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Platea methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 15:29'!calcularPrecio	^ ((nombre  last: 2) asInteger )*tarifaUbicacion .! !!Platea methodsFor: 'initialization' stamp: 'Alexander 9/24/2026 15:32'!initialize super initialize .! !Ubicacion subclass: #Vip	instanceVariableNames: 'cantidadDeLugaresDisponibles'	classVariableNames: ''	package: 'TP1'!!Vip methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 15:29'!calcularPrecio	|cantidadActual|	cantidadActual := cantidadDeLugaresDisponibles.	cantidadDeLugaresDisponibles := cantidadDeLugaresDisponibles -1.		^ tarifaUbicacion / cantidadActual  .! !!Vip methodsFor: 'as yet unclassified' stamp: 'Alexander 9/24/2026 22:45'!conLugarEn: unNombreDeUbicacion yUnaTarifaDe: unaTarifa lugaresDisponibles: unaCantidadDeLugaresDisponibles(unaCantidadDeLugaresDisponibles <0 ) ifTrue: [ ErrorCantidadDeLugaresDisponibles signal ].cantidadDeLugaresDisponibles:= unaCantidadDeLugaresDisponibles.self conLugarEn: unNombreDeUbicacion yUnaTarifaDe: unaTarifa  .! !!Vip methodsFor: 'initialization' stamp: 'Alexander 9/24/2026 16:09'!initialize super initialize .cantidadDeLugaresDisponibles :=1.! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Vip class	instanceVariableNames: ''!!Vip class methodsFor: 'not defined category' stamp: 'Alexander 9/23/2026 23:47'!conLugarEn: unNombreDeUbicacion yUnaTarifaDe: unaTarifa lugaresDisponibles: cantidadDeLugaresDisponibles ^self new conLugarEn: unNombreDeUbicacion yUnaTarifaDe: unaTarifa lugaresDisponibles: cantidadDeLugaresDisponibles! !