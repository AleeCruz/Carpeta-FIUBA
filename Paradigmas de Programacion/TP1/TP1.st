d ** (2+calidad))+evaluacion.! !!JugadorSuplente methodsFor: 'test' stamp: 'Alexander 4/18/2026 23:36'!tienesCalidad	^true.! !!JugadorSuplente methodsFor: 'initialization' stamp: 'Alexander 4/22/2026 09:34'!initialize 	evaluacion :=0.0.! !!JugadorSuplente methodsFor: 'accessing' stamp: 'Alexander 4/18/2026 22:31'!nombre	^ nombre! !Object subclass: #JugadorTitular	instanceVariableNames: 'nombre habilidad cansancio experiencia'	classVariableNames: ''	package: 'TP1'!!JugadorTitular methodsFor: 'test' stamp: 'Alexander 4/22/2026 00:50'!reducirCansancio	cansancio := cansancio -experiencia .! !!JugadorTitular methodsFor: 'test' stamp: 'Alexander 4/18/2026 23:36'!tienesCalidad	^false ! !!JugadorTitular methodsFor: 'test' stamp: 'Alexander 4/19/2026 00:42'!decimeTuRendimiento 	^ ((habilidad squared )*cansancio ).! !!JugadorTitular methodsFor: 'test' stamp: 'Alexander 4/23/2026 16:17'!nombre: unNombre habilidad: unaHabilidad cansancio: unCansancio experiencia: unaExperiencia (unaHabilidad <0) ifTrue: [ HabilidadInvalida signal ].(unCansancio  <0) ifTrue: [ CansancioInvalido signal ]. nombre:= unNombre .habilidad := unaHabilidad .cansancio := unCansancio .experiencia := unaExperiencia .! !!JugadorTitular methodsFor: 'accessing' stamp: 'Alexander 4/18/2026 22:31'!nombre	^ nombre! !!JugadorTitular methodsFor: 'accessing' stamp: 'Alexander 4/22/2026 00:50'!cansancio	^ cansancio! !Object subclass: #Manager	instanceVariableNames: 'jugadores'	classVariableNames: ''	package: 'TP1'!!Manager methodsFor: 'not defined category' stamp: 'Alexander 4/23/2026 15:28'!agregar: algunJugador a: unEquipo 	jugadores := OrderedCollection withAll: unEquipo.	jugadores add: algunJugador .		 	! !