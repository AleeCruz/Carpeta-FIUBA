TestCase subclass: #CasosDeUso	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 4/18/2026 21:59'!test02SeAgregaUnJugadorSinExperienciaYSePideLaCantidadDeJugadoresPresentes"Arrange "|equipo|"Act"equipo := { Jugador nombre: 'Guido Rodriguez' habilidad: 60 cansancio: 50 experiencia: 2. } ."Assert"self assert: (equipo size)  equals: 1.! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 4/19/2026 00:32'!test08DadoUnJugadorSuplentePreguntarSiTieneCalidad"Arrange"|equipo |"Act"equipo := { Jugador nombre: 'Guido Rodriguez' habilidad: 60 cansancio: 50 experiencia: 2. Jugador nombre: 'Paulo Dybala' habilidad: 90 calidad: 0.9 experiencia:  5.Jugador nombre: 'Paredes' habilidad: 70 cansancio: 90 experiencia: 5 . }."Assert"self assert: (equipo at:3) tienesCalidad equals: false .! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 4/19/2026 13:09'!test06SeAgreganUnEquipoDeTresJugadoresDondeElegirPateadorEligeAlgunJugadorConRendimientoMinimo"Arrange"|equipo eleccion jugadorAPatear |"Act"equipo := { Jugador nombre: 'Guido Rodriguez' habilidad: 60 cansancio: 50 experiencia: 2. Jugador nombre: 'Paulo Dybala' habilidad: 90 calidad: 0.9 experiencia:  5.Jugador nombre: 'Paredes' habilidad: 70 cansancio: 90 experiencia: 5 . }.eleccion := ElegirPateador habiendoEmpatadoComo: equipo.jugadorAPatear := eleccion peorPateador."Assert"self assert: jugadorAPatear nombre  equals: 'Guido Rodriguez' .! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 4/18/2026 22:31'!test05SeAgreganUnEquipoDeTresJugadoresDondeElegirPateadorTendraLaColeccionDeTamanio3"Arrange"|equipo eleccion jugadorAPatear |"Act"equipo := { Jugador nombre: 'Guido Rodriguez' habilidad: 60 cansancio: 50 experiencia: 2. Jugador nombre: 'Paulo Dybala' habilidad: 90 calidad: 0.9 experiencia:  5.Jugador nombre: 'Paredes' habilidad: 70 cansancio: 90 experiencia: 5 . }.eleccion := ElegirPateador habiendoEmpatadoComo: equipo.jugadorAPatear := eleccion mejorPateador."Assert"self assert: jugadorAPatear nombre  equals: 'Paulo Dybala'.! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 4/18/2026 21:55'!test01SeAgregaUnJugadorConAmpliaExperienciaYSePideLaCantidadDeJugadoresPresentes"Arrange "|equipo|"Act"equipo := { Jugador nombre: 'Paredes' habilidad: 70 cansancio: 90 experiencia: 5 } ."Assert"self assert: (equipo size ) equals: 1.! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 4/18/2026 22:19'!test04SeAgreganUnEquipoDeTresJugadoresDistintosDevolvemosLaCantidad"Arrange"|equipo|"Act"equipo := { Jugador nombre: 'Guido Rodriguez' habilidad: 60 cansancio: 50 experiencia: 2. Jugador nombre: 'Paulo Dybala' habilidad: 90 calidad: 0.9 experiencia:  5.Jugador nombre: 'Paredes' habilidad: 70 cansancio: 90 experiencia: 5 . }."Assert"self assert: equipo size equals: 3.! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 4/19/2026 00:59'!test09unJugadorNovatoTieneMejorPuntuacionQueUnTitular"Arrange"|equipo eleccion unJugadorAPatear|"Act"equipo := { Jugador nombre: 'Guido Rodriguez' habilidad: 120 cansancio: 80 experiencia: 2. Jugador nombre: 'Paredes' habilidad: 70 cansancio: 90 experiencia: 5 . }.eleccion := ElegirPateador habiendoEmpatadoComo: equipo.unJugadorAPatear := eleccion mejorPateador ."Assert"self assert:   unJugadorAPatear nombre equals:  'Guido Rodriguez' .! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 4/19/2026 00:30'!test07DadoUnJugadorTitularPreguntarSiTiene"Arrange"|equipo |"Act"equipo := { Jugador nombre: 'Guido Rodriguez' habilidad: 60 cansancio: 50 experiencia: 2. Jugador nombre: 'Paulo Dybala' habilidad: 90 calidad: 0.9 experiencia:  5.Jugador nombre: 'Paredes' habilidad: 70 cansancio: 90 experiencia: 5 . }."Assert"self assert: (equipo at:1) tienesCalidad equals: false .! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 4/18/2026 22:04'!test03SeAgregaUnJugadorSuplenteConCalidadYSePideLaCantidadDeJugadoresPresentes"Arrange "|equipo|"Act"equipo := { Jugador nombre: 'Paulo Dybala' habilidad: 90 calidad: 0.9 experiencia:  5.} ."Assert"self assert: (equipo size)  equals: 1.! !Object subclass: #ElegirPateador	instanceVariableNames: 'jugadores'	classVariableNames: ''	package: 'TP1'!!ElegirPateador methodsFor: 'test' stamp: 'Alexander 4/18/2026 23:44'!habiendoGanadoComo: unEquipoColeccion 		jugadores := unEquipoColeccion collect: [ :unJugador | 			(unJugador tienesCalidad) ifTrue: [ unJugador incrementarEvaluacionEn:80000 ]											 ifFalse: [ unJugador ]			]! !!ElegirPateador methodsFor: 'test' stamp: 'Alexander 4/18/2026 23:53'!peorPateador	|elPeorPateador|	elPeorPateador := jugadores detectMin:  [ :algunJugador | algunJugador decimeTuRendimiento ].	^ elPeorPateador .! !!ElegirPateador methodsFor: 'test' stamp: 'Alexander 4/19/2026 13:11'!habiendoPerdidoComo: unEquipoColeccion 	jugadores := unEquipoColeccion collect: [ :algunJugador | 		algunJugador reducirCansansio ]																							! !!ElegirPateador methodsFor: 'test' stamp: 'Alexander 4/18/2026 22:26'!mejorPateador	|elMejorPateador|	elMejorPateador := jugadores detectMax: [ :algunJugador | algunJugador decimeTuRendimiento ].	^ elMejorPateador .! !!ElegirPateador methodsFor: 'test' stamp: 'Alexander 4/18/2026 22:07'!habiendoEmpatadoComo: unEquipoColeccion 	jugadores := unEquipoColeccion .! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ElegirPateador class	instanceVariableNames: ''!!ElegirPateador class methodsFor: 'test' stamp: 'Alexander 4/18/2026 23:27'!habiendoGanadoComo: unaColeccionEquipo 	|unElegirPateador|	unElegirPateador := self new.	^ unElegirPateador habiendoGanadoComo: unaColeccionEquipo ! !!ElegirPateador class methodsFor: 'test' stamp: 'Alexander 4/19/2026 00:01'!habiendoPerdidoComo: unEquipoColeccion 	|unElegirPateador|	unElegirPateador := self new.	^ unElegirPateador habiendoPerdidoComo: unEquipoColeccion .! !!ElegirPateador class methodsFor: 'test' stamp: 'Alexander 4/18/2026 22:05'!habiendoEmpatadoComo: unEquipoColeccion 	|unElegirPateador|		unElegirPateador := self new.	unElegirPateador habiendoEmpatadoComo: unEquipoColeccion.	^ unElegirPateador .! !Object subclass: #Jugador	instanceVariableNames: 'nombre'	classVariableNames: ''	package: 'TP1'!!Jugador methodsFor: 'test' stamp: 'Alexander 4/18/2026 22:02'!nombre: unNombre habilidad: unaHabilidad calidad: unaCalidad experiencia: unaExperiencia  	|unJugadorSuplente|	^ (JugadorSuplente new nombre: unNombre habilidad: unaHabilidad calidad: unaCalidad experiencia: unaExperiencia).! !!Jugador methodsFor: 'test' stamp: 'Alexander 4/18/2026 21:52'!nombre: unNombre habilidad: unaHabilidad cansancio: unCansancio experiencia: unaExperiencia (unaExperiencia < 3) ifTrue: [ 	^ (JugadorNovato new nombre: unNombre habilidad: unaHabilidad cansancio: unCansancio experiencia: unaExperiencia ).	 ].	^ (JugadorTitular new nombre: unNombre habilidad: unaHabilidad cansancio: unCansancio experiencia: unaExperiencia ).! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Jugador class	instanceVariableNames: ''!!Jugador class methodsFor: 'test' stamp: 'Alexander 4/18/2026 22:01'!nombre: unNombre habilidad: unaHabilidad calidad: unaCalidad experiencia: unaExperiencia  	|unJugador|	unJugador := self new.	^(unJugador nombre: unNombre habilidad: unaHabilidad calidad: unaCalidad experiencia: unaExperiencia ) ! !!Jugador class methodsFor: 'test' stamp: 'Alexander 4/18/2026 21:49'!nombre: unNombre habilidad: unaHabilidad cansancio: unCansancio experiencia: unaExperiencia 	|unJugador|	unJugador := self new.	^ (unJugador nombre: unNombre habilidad: unaHabilidad cansancio: unCansancio experiencia: unaExperiencia).		! !Object subclass: #JugadorNovato	instanceVariableNames: 'nombre habilidad cansancio experiencia'	classVariableNames: ''	package: 'TP1'!!JugadorNovato methodsFor: 'accessing' stamp: 'Alexander 4/18/2026 23:53'!nombre	^ nombre! !!JugadorNovato methodsFor: 'test' stamp: 'Alexander 4/19/2026 00:33'!decimeTuRendimiento	^ ((habilidad squared )*cansancio )/2.! !!JugadorNovato methodsFor: 'test' stamp: 'Alexander 4/18/2026 23:36'!tienesCalidad	^false ! !!JugadorNovato methodsFor: 'test' stamp: 'Alexander 4/18/2026 21:57'!nombre: unNombre habilidad: unaHabilidad cansancio: unCansancio experiencia: unaExperiencianombre := unNombre .habilidad := unaHabilidad .cansancio := unCansancio .experiencia := unaExperiencia . 	! !Object subclass: #JugadorSuplente	instanceVariableNames: 'nombre habilidad calidad experiencia evaluacion'	classVariableNames: ''	package: 'TP1'!!JugadorSuplente methodsFor: 'initialization' stamp: 'Alexander 4/19/2026 01:19'!initialize 	super initialize .	evaluacion :=0.0.! !!JugadorSuplente methodsFor: 'accessing' stamp: 'Alexander 4/18/2026 22:31'!nombre	^ nombre! !!JugadorSuplente methodsFor: 'test' stamp: 'Alexander 4/18/2026 23:37'!decimeTuRendimiento 	 ^ (habilidad ** (2+calidad))+evaluacion.! !!JugadorSuplente methodsFor: 'test' stamp: 'Alexander 4/18/2026 23:44'!incrementarEvaluacionEn: unValorEvaluacion 	evaluacion := unValorEvaluacion .! !!JugadorSuplente methodsFor: 'test' stamp: 'Alexander 4/18/2026 22:03'!nombre: unNombre habilidad: unaHabilidad calidad: unaCalidad experiencia: unaExperiencia  nombre := unNombre .habilidad := unaHabilidad .calidad := unaCalidad .experiencia := unaExperiencia .! !!JugadorSuplente methodsFor: 'test' stamp: 'Alexander 4/18/2026 23:36'!tienesCalidad	^true.! !Object subclass: #JugadorTitular	instanceVariableNames: 'nombre habilidad cansancio experiencia'	classVariableNames: ''	package: 'TP1'!!JugadorTitular methodsFor: 'test' stamp: 'Alexander 4/19/2026 00:42'!decimeTuRendimiento 	^ ((habilidad squared )*cansancio ).! !!JugadorTitular methodsFor: 'test' stamp: 'Alexander 4/19/2026 00:09'!reducirCansansio	cansancio := cansancio -experiencia .! !!JugadorTitular methodsFor: 'test' stamp: 'Alexander 4/18/2026 23:36'!tienesCalidad	^false ! !!JugadorTitular methodsFor: 'test' stamp: 'Alexander 4/18/2026 21:54'!nombre: unNombre habilidad: unaHabilidad cansancio: unCansancio experiencia: unaExperiencia  nombre:= unNombre .habilidad := unaHabilidad .cansancio := unCansancio .experiencia := unaExperiencia .! !!JugadorTitular methodsFor: 'accessing' stamp: 'Alexander 4/18/2026 22:31'!nombre	^ nombre! !