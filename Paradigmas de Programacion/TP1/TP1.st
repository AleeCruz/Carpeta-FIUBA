oleccion.	^ unElegirPateador .! !!ElegirPateador class methodsFor: 'test' stamp: 'Alexander 4/18/2026 23:27'!habiendoGanadoComo: unaColeccionEquipo 	|unElegirPateador|	unElegirPateador := self new.	^ unElegirPateador habiendoGanadoComo: unaColeccionEquipo ! !!ElegirPateador class methodsFor: 'test' stamp: 'Alexander 4/19/2026 00:01'!habiendoPerdidoComo: unEquipoColeccion 	|unElegirPateador|	unElegirPateador := self new.	^ unElegirPateador habiendoPerdidoComo: unEquipoColeccion .! !Error subclass: #ExperienciaInvalida	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!Error subclass: #HabilidadInvalida	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!Object subclass: #Jugador	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Jugador methodsFor: 'test' stamp: 'Alexander 4/23/2026 16:19'!nombre: unNombre habilidad: unaHabilidad cansancio: unCansancio experiencia: unaExperiencia (unaExperiencia <0) ifTrue: [ ExperienciaInvalida signal ].(unaExperiencia < 3) ifTrue: [ 	^ (JugadorNovato new nombre: unNombre habilidad: unaHabilidad cansancio: unCansancio experiencia: unaExperiencia ).	 ].	^ (JugadorTitular new nombre: unNombre habilidad: unaHabilidad cansancio: unCansancio experiencia: unaExperiencia ).! !!Jugador methodsFor: 'test' stamp: 'Alexander 4/23/2026 15:45'!nombre: unNombre habilidad: unaHabilidad calidad: unaCalidad experiencia: unaExperiencia  		^ (JugadorSuplente new nombre: unNombre habilidad: unaHabilidad calidad: unaCalidad experiencia: unaExperiencia).! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Jugador class	instanceVariableNames: ''!!Jugador class methodsFor: 'test' stamp: 'Alexander 4/18/2026 21:49'!nombre: unNombre habilidad: unaHabilidad cansancio: unCansancio experiencia: unaExperiencia 	|unJugador|	unJugador := self new.	^ (unJugador nombre: unNombre habilidad: unaHabilidad cansancio: unCansancio experiencia: unaExperiencia).		! !!