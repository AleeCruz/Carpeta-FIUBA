Object subclass: #AlgoTek	instanceVariableNames: 'eventos'	classVariableNames: ''	package: 'TP1'!!AlgoTek methodsFor: 'initialization' stamp: 'Ale 10/14/2026 02:33'!initialize eventos := OrderedCollection new.! !!AlgoTek methodsFor: 'as yet unclassified' stamp: 'Alexander 10/14/2026 05:46'!paraEvento: unNombreDeEvento registrarUbicacionCampo: unNombreDeUbicacion tarifa: unaTarifaParaLaUbicacion |unaUbicacion unEvento |unEvento := self buscarEventoLlamado: unNombreDeEvento.unaUbicacion:= Campo conNombre: unNombreDeUbicacion  yUnaTarifaDe:unaTarifaParaLaUbicacion.unEvento registrarUbicacion: unaUbicacion .! !!AlgoTek methodsFor: 'as yet unclassified' stamp: 'Alexander 10/14/2026 05:46'!paraEvento: unNombreDeEvento registrarUbicacionPlateaPreferencial: unNombreDeUbicacion tarifa: unaTarifaParaLaUbicacion | unaUbicacion unEvento |unEvento := self buscarEventoLlamado: unNombreDeEvento.unaUbicacion := Platea conNombre: unNombreDeUbicacion  yUnaTarifaDe: unaTarifaParaLaUbicacion.unEvento registrarUbicacion: unaUbicacion.! !!AlgoTek methodsFor: 'as yet unclassified' stamp: 'Ale 10/14/2026 02:34'!registrarEvento: unNombreEvento deArtista: unArtista 	eventos add: ( Evento deNombre: unNombreEvento  conUnArtista: unArtista)! !!AlgoTek methodsFor: 'not defined category' stamp: 'Ale 10/14/2026 04:02'!buscarEventoLlamado: unNombredeEvento 	^ eventos detect: [ :e| e conNombre: unNombredeEvento ] ifNone: [EventoNoEncontrado signal].! !!AlgoTek methodsFor: 'not defined category' stamp: 'Ale 10/14/2026 02:47'!entradaMasBarataPara: unNombreDeEvento pagandoCon: unMedioDEPago |unEvento|unEvento := self buscarEventoLlamado: unNombreDeEvento .	^ unEvento entradaMasBarataPagandoCon: unMedioDEPago														! !!AlgoTek methodsFor: 'not defined category' stamp: 'Alexander 10/14/2026 05:46'!paraEvento: unNombreDeEvento registrarUbicacionViP: unNombreDeUbicacion tarifa: unaTarifa lugaresDisponibles: unaCantidadDeLugares |unaUbicacion unEvento |unEvento := self buscarEventoLlamado: unNombreDeEvento.unaUbicacion := Vip conLugarEn: unNombreDeUbicacion yUnaTarifaDe: unaTarifa lugaresDisponibles: unaCantidadDeLugares.	unEvento registrarUbicacion: unaUbicacion .! !!AlgoTek methodsFor: 'not defined category' stamp: 'Ale 10/14/2026 02:47'!costoEntradaPara: unNombreEvento enUbicacion: unNombreUbicacion pagandoCon: unMedioDePago|unEvento|unEvento := self buscarEventoLlamado: unNombreEvento .^ unEvento calcularEntradaDe: unNombreUbicacion con: unMedioDePago! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!AlgoTek class	instanceVariableNames: ''!!AlgoTek class methodsFor: 'not defined category' stamp: 'Ale 10/13/2026 20:41'!registrarEvento: unNombreEvento deArtistaInternacional: unNombreArtistaNacional conTarifaArtista: unaTarifa 	|unArtista algotek|	unArtista := Internacional conNombre: unNombreArtistaNacional yUnaTarifaDe: unaTarifa.	algotek := self new.	algotek registrarEvento: unNombreEvento deArtista: unArtista.	^algotek ! !!AlgoTek class methodsFor: 'not defined category' stamp: 'Ale 10/13/2026 20:41'!registrarEvento: unNombreEvento deArtistaNacional: unNombreArtistaNacional conTarifaArtista: unaTarifa 	|unArtista algotek|	unArtista := Nacional conNombre: unNombreArtistaNacional yUnaTarifaDe: unaTarifa.	algotek := self new.	algotek registrarEvento: unNombreEvento deArtista: unArtista.	^algotek ! !Object subclass: #Artista	instanceVariableNames: 'nombre tarifaArtista'	classVariableNames: ''	package: 'TP1'!!Artista methodsFor: 'initialization' stamp: 'Alexander 9/24/2026 16:23'!initialize nombre := 'Sin Nombre'.tarifaArtista := 0.! !!Artista methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 12:15'!calcularCosto 	self subclassResponsibility .! !!Artista methodsFor: 'not defined category' stamp: 'Ale 10/14/2026 03:17'!conNombre: unNombreDeArtista yUnaTarifaDe: unaTarifa(unaTarifa <0 ) ifTrue: [ ValorInvalidoTarifaDelArtistaInvalido signal ].nombre := unNombreDeArtista .tarifaArtista  := unaTarifa .! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Artista class	instanceVariableNames: ''!!Artista class methodsFor: 'not defined category' stamp: 'Ale 10/13/2026 22:10'!conNombre: unNombre yUnaTarifaDe: unaTarifa 	|unArtista|	unArtista := self new.	unArtista conNombre: unNombre yUnaTarifaDe: unaTarifa.	^unArtista .! !Error subclass: #ElementosNoEncontrados	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!Object subclass: #Evento	instanceVariableNames: 'nombreDelEvento artista ubicaciones'	classVariableNames: ''	package: 'TP1'!!Evento methodsFor: 'not defined category' stamp: 'Ale 10/14/2026 00:32'!conNombre: unNombre 	^ nombreDelEvento =unNombre ! !!Evento methodsFor: 'not defined category' stamp: 'Alexander 10/16/2026 05:37'!entradaMasBarataPagandoCon: unMedioDePago 	| tarifaMinima costoBase ubicacionMasBarata|    ubicacionMasBarata := (ubicaciones detectMin:  [ :ubicacion | ubicacion calcularPrecio ]).	tarifaMinima := ubicacionMasBarata calcularPrecio.    costoBase := (artista calcularCosto) + tarifaMinima.    ^ unMedioDePago obtenerBeneficio: costoBase.! !!Evento methodsFor: 'not defined category' stamp: 'Ale 10/14/2026 04:02'!calcularEntradaDe: unNombreDeUbicacion con: unMedioDePago 	|unaUbicacion costoBase|	unaUbicacion := ubicaciones detect: [ :ubicacion | ubicacion conNombre: unNombreDeUbicacion ]										ifNone:[UbicacionNoEncontrada signal].	costoBase := (artista  calcularCosto) + (unaUbicacion calcularPrecio).	^ unMedioDePago obtenerBeneficio: costoBase.! !!Evento methodsFor: 'as yet unclassified' stamp: 'Alexander 10/14/2026 05:46'!registrarUbicacion: unaUbicacionubicaciones add: unaUbicacion .! !!Evento methodsFor: 'as yet unclassified' stamp: 'Ale 10/11/2026 01:18'!deNombre: unNombreDeEvento conUnArtista: unArtista	nombreDelEvento := unNombreDeEvento .	artista := unArtista ! !!Evento methodsFor: 'initialization' stamp: 'Ale 10/13/2026 20:41'!initialize 	nombreDelEvento := 'Sin Definir'.	artista := Nacional conNombre: 'SinNombre' yUnaTarifaDe: 1. 	ubicaciones := OrderedCollection new.	! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Evento class	instanceVariableNames: ''!!Evento class methodsFor: 'not defined category' stamp: 'Ale 10/11/2026 01:20'!deNombre: unNombreDeEvento conUnArtista: unArtista|evento|evento := self new.evento deNombre: unNombreDeEvento conUnArtista: unArtista.^evento ! !ElementosNoEncontrados subclass: #EventoNoEncontrado	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!Artista subclass: #Internacional	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Internacional methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 16:25'!calcularCosto	^ ((tarifaArtista  * 2) / 5 + 1000)! !!Internacional methodsFor: 'initialization' stamp: 'Ale 10/13/2026 22:11'!initialize super initialize .! !Object subclass: #MedioDePago	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!MedioDePago subclass: #Efectivo	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Efectivo methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 00:33'!obtenerBeneficio: precioDeEntrada	^ precioDeEntrada .! !Artista subclass: #Nacional	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Nacional methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 16:24'!calcularCosto	^ tarifaArtista log.! !!Nacional methodsFor: 'initialization' stamp: 'Alexander 9/24/2026 16:24'!initialize 	super initialize.! !Error subclass: #SinLugaresDisponibles	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!MedioDePago subclass: #Tarjeta	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Tarjeta methodsFor: 'not defined category' stamp: 'Alexander 10/16/2026 01:46'!obtenerBeneficio: precioDeEntrada	 ^precioDeEntrada*0.8										! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Tarjeta class	instanceVariableNames: ''!!Tarjeta class methodsFor: 'not defined category' stamp: 'Alexander 10/16/2026 01:49'!conNombre: unNombre 	|tarjeta|	tarjeta := self new.	^ tarjeta .! !Object subclass: #Ubicacion	instanceVariableNames: 'nombre tarifaUbicacion'	classVariableNames: ''	package: 'TP1'!!Ubicacion methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 15:35'!calcularPrecio 	self subclassResponsibility .! !!Ubicacion methodsFor: 'not defined category' stamp: 'Ale 10/14/2026 03:17'!conNombre: unNombreDeLugar yUnaTarifaDe: unaTarifaDelLugar 	(unaTarifaDelLugar <0)ifTrue: [ ValorInvalidoTarifaDeUbicacionInvalido signal ].	nombre:= unNombreDeLugar .	tarifaUbicacion:=unaTarifaDelLugar .! !!Ubicacion methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 15:34'!conNombre: unNombreDeUbicacion 	^ nombre sameAs: unNombreDeUbicacion ! !!Ubicacion methodsFor: 'initialization' stamp: 'Alexander 9/24/2026 15:32'!initialize 	nombre := 'Sin Nombre'.	tarifaUbicacion :=0.! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Ubicacion class	instanceVariableNames: ''!!Ubicacion class methodsFor: 'not defined category' stamp: 'Ale 10/13/2026 20:41'!conNombre: unNombreDelLugar yUnaTarifaDe: unaTarifa 	^self new conNombre: unNombreDelLugar yUnaTarifaDe: unaTarifa.! !Ubicacion subclass: #Campo	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Campo methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 15:28'!calcularPrecio	^ tarifaUbicacion .! !!Campo methodsFor: 'initialization' stamp: 'Alexander 9/24/2026 15:31'!initialize 	super initialize .! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Campo class	instanceVariableNames: ''!!Campo class methodsFor: 'not defined category' stamp: 'Ale 10/13/2026 20:41'!conNombre: unNombre yUnaTarifaDe: unaTarifa 	|unCampo|	unCampo := self new.	unCampo conNombre: unNombre yUnaTarifaDe: unaTarifa.	^unCampo .! !Ubicacion subclass: #Platea	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Platea methodsFor: 'not defined category' stamp: 'Alexander 9/24/2026 15:29'!calcularPrecio	^ ((nombre  last: 2) asInteger )*tarifaUbicacion .! !!Platea methodsFor: 'initialization' stamp: 'Alexander 9/24/2026 15:32'!initialize super initialize .! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Platea class	instanceVariableNames: ''!!Platea class methodsFor: 'not defined category' stamp: 'Ale 10/13/2026 20:41'!conNombre: unNombreDeUbicacion yUnaTarifaDe: unaTarifa 	|unaPlatea|	unaPlatea := self new.	unaPlatea conNombre: unNombreDeUbicacion yUnaTarifaDe: unaTarifa.	^unaPlatea ! !ElementosNoEncontrados subclass: #UbicacionNoEncontrada	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!Error subclass: #ValoresInvalidos	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!ValoresInvalidos subclass: #ValorInvalidoCantidadDeLugaresDisponibles	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!ValoresInvalidos subclass: #ValorInvalidoTarifaDeUbicacionInvalido	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!ValoresInvalidos subclass: #ValorInvalidoTarifaDelArtistaInvalido	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!Ubicacion subclass: #Vip	instanceVariableNames: 'cantidadDeLugaresDisponibles'	classVariableNames: ''	package: 'TP1'!!Vip methodsFor: 'not defined category' stamp: 'Alexander 10/14/2026 05:27'!calcularPrecio	|cantidadActual|	cantidadActual := cantidadDeLugaresDisponibles.	cantidadDeLugaresDisponibles := cantidadDeLugaresDisponibles -1.	(cantidadActual  >0 ) ifFalse: [ SinLugaresDisponibles signal ].	^ tarifaUbicacion / cantidadActual  .! !!Vip methodsFor: 'not defined category' stamp: 'Alexander 10/14/2026 19:43'!conLugarEn: unNombre yUnaTarifaDe: unaTarifa lugaresDisponibles: unaCantidadDeLugaresDisponibles(unaCantidadDeLugaresDisponibles <0 ) ifTrue: [ ValorInvalidoCantidadDeLugaresDisponibles signal ].cantidadDeLugaresDisponibles:= unaCantidadDeLugaresDisponibles.self conNombre: unNombre yUnaTarifaDe: unaTarifa  .! !!Vip methodsFor: 'initialization' stamp: 'Alexander 9/24/2026 16:09'!initialize super initialize .cantidadDeLugaresDisponibles :=1.! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Vip class	instanceVariableNames: ''!!Vip class methodsFor: 'not defined category' stamp: 'Alexander 9/23/2026 23:47'!conLugarEn: unNombreDeUbicacion yUnaTarifaDe: unaTarifa lugaresDisponibles: cantidadDeLugaresDisponibles ^self new conLugarEn: unNombreDeUbicacion yUnaTarifaDe: unaTarifa lugaresDisponibles: cantidadDeLugaresDisponibles! !