oTek := AlgoTek registrarEvento: 'La Ultima Noche Magica En River' deArtistaNacional: 'Tan Bionica' conTarifaArtista: 50000.algoTek paraEvento: evento registrarUbicacionCampo: 'Campo General' tarifa: 16000.self should: [	algoTek paraEvento: evento registrarUbicacionCampo: 'Campo General' tarifa: -12.	] raise: ErrorTarifaDeUbicacionInvalido   .! !!AlgoTekTestPropios methodsFor: 'tests' stamp: 'Alexander 9/24/2026 22:43'!test06NoSePuedeAgregarUnaCantidadDeLugaresInvalidosEnLosVips| algoTek evento  |"Arrange"evento:= 'La Ultima Noche Magica En River'.algoTek := AlgoTek registrarEvento: 'La Ultima Noche Magica En River' deArtistaNacional: 'Tan Bionica' conTarifaArtista: 50000.algoTek paraEvento: evento registrarUbicacionViP: 'Hospitality' tarifa: 40000 lugaresDisponibles: 2.self should: [	algoTek paraEvento: evento registrarUbicacionViP: 'Hospitality' tarifa: 40000 lugaresDisponibles: -2.	] raise: ErrorCantidadDeLugaresDisponibles    .! !TestCase subclass: #ArtistaTest	instanceVariableNames: ''	classVariableNames: ''	package: 'Tp1-Casos-De-Uso'!!ArtistaTest methodsFor: 'tests' stamp: 'Alexander 9/24/2026 00:07'!test01UnArtistaNacionalSabeQueElEstadoLoSubsidia"Arrange"|unArtista resultadoEsperado resultadoObtenido |resultadoEsperado := 50000 log."Act"unArtista := Nacional conNombre: 'Tan Bionica' conTarifaDe: 50000.resultadoObtenido:= unArtista calcularCosto."Assert"self assert: resultadoObtenido equals: resultadoEsperado! !TestCase subclass: #EventoTest	instanceVariableNames: ''	classVariableNames: ''	package: 'Tp1-Casos-De-Uso'!!EventoTest methodsFor: 'tests' stamp: 'Alexander 9/24/2026 18:20'!test04ElPrecioDeUnArtistaNacionalYUnaUbicacionDeCampoTieneUnDeterminadoValor"Arrange"|unEvento resultadoEsperado   resultadoObtenido evento efectivo algoTek  |resultadoEsperado := (50000 log)+(16000).	evento := 'La Ultima Noche Magica En River'.	efectivo := Efectivo new.	algoTek := AlgoTek registrarEvento: evento deArtistaNacional: 'Tan Bionica' conTarifaArtista: 50000.	algoTek paraEvento: evento registrarUbicacionCampo: 'Campo General' tarifa: 16000.		unEvento := algoTek buscarEventoLlamado: evento .	 	resultadoObtenido := unEvento calcularEntradaDe: 'Campo General'  con: efectivo . "Assert: " self assert: resultadoObtenido closeTo: resultadoEsperado  precision: 0.001! !!EventoTest methodsFor: 'tests' stamp: 'Alexander 9/24/2026 18:18'!test03ElPrecioDeUnArtistaNacionalYUnaUbicacionPlateaTieneUnDEterminadoValor"Arrange"|unEvento resultadoEsperado   resultadoObtenido evento efectivo algoTek  |resultadoEsperado := (50000 log)+(12*25000).	evento := 'La Ultima Noche Magica En River'.	efectivo := Efectivo new.	algoTek := AlgoTek registrarEvento: evento deArtistaNacional: 'Tan Bionica' conTarifaArtista: 50000.	algoTek paraEvento: evento registrarUbicacionPlateaPreferencial: 'M912' tarifa: 25000.		unEvento := algoTek buscarEventoLlamado: evento .	 	resultadoObtenido := unEvento calcularEntradaDe: 'M912'  con: efectivo . "Assert: " self assert: resultadoObtenido   closeTo: resultadoEsperado  precision: 0.001! !!EventoTest methodsFor: 'tests' stamp: 'Alexander 9/24/2026 19:00'!test10UnEventoCalculaLaEntradaMasBarataCuandoRecibeUnEventoYUnMedioDePago"Arrange"|unEvento evento resultadoEsperado resultadoObtenido unMedioDePago |evento := 'La Ultima Noche Magica En River'.unMedioDePago := Efectivo new.resultadoEsperado := ((100000 * 2) / 5 + 1000 )+40000."Act"	unEvento  := Evento deNombre:  evento  conUnArtistaInternacional:'Taylor Swift' deTarifa: 100000.		unEvento  paraEvento: evento registrarUbicacionPlateaPreferencial: 'M912' tarifa: 25000.	unEvento paraEvento: evento registrarUbicacionPlateaPreferencial: 'D018' tarifa: 20000.	unEvento paraEvento: evento registrarUbicacionCampo: 'Campo Delantero' tarifa: 75000. "ay amiga, + sErVIcE CHanGe"	unEvento paraEvento: evento registrarUbicacionCampo: 'Campo Trasero' tarifa: 40000.	unEvento paraEvento: evento registrarUbicacionViP: 'Karma is my Boyfriend' tarifa: 155000 lugaresDisponibles: 2.	unEvento paraEvento: evento registrarUbicacionViP: 'Its a Love Story' tarifa: 85000 lugaresDisponibles: 2.	resultadoObtenido := unEvento entradaMasBarataPagandoCon: unMedioDePago ."Assert"self assert: resultadoObtenido  closeTo: resultadoEsperado precision:  0.001 .! !!EventoTest methodsFor: 'tests' stamp: 'Alexander 9/23/2026 22:03'!test06SeRegistraUnEventoParticularConUnArtistaNacionalYSuTarifa"Arrange"| resultadoEsperado unEvento resultadoObtenido |resultadoEsperado:= 'Tan Bionica'."Act"unEvento := Evento deNombre:'La Ultima Noche Magica En River' conUnArtistaNacional: 'Tan Bionica' deTarifa: 50000.resultadoObtenido := unEvento artista  ."Assert"self assert: resultadoObtenido nombre equals: resultadoEsperado.! !!EventoTest methodsFor: 'tests' stamp: 'Alexander 9/23/2026 16:17'!test02SeAgregaronDosArtistasInteracionalesDiferentesEnELMismoEvento"Arrange"|unEvento resultadoEsperado resultadoObtenido |"Act"resultadoEsperado:= 2.unEvento := Evento registraUnArtistaInteracionalDeNombre: 'Taylor Swift' conUnaTarifaDe: 50000.unEvento registraUnArtistaInteracionalDeNombre: 'Ricardo Arjona' conUnaTarifaDe: 30000."Assert"resultadoObtenido:= unEvento decimeLaCantidadDeArtistas."Arrange"self assert: resultadoObtenido equals: resultadoEsperado.! !!EventoTest methodsFor: 'tests' stamp: 'Alexander 9/24/2026 18:23'!test05ElPrecioDeUnArtistaNacionalYUnaUbicacionVIPTieneUnDeterminadoValor"Arrange"|unEvento resultadoEsperado   resultadoObtenido evento efectivo algoTek  |resultadoEsperado := (50000 log)+(40000/2).	evento := 'La Ultima Noche Magica En River'.	efectivo := Efectivo new.	algoTek := AlgoTek registrarEvento: evento deArtistaNacional: 'Tan Bionica' conTarifaArtista: 50000.	algoTek paraEvento: evento registrarUbicacionViP: 'Hospitality' tarifa: 40000 lugaresDisponibles: 2.	unEvento := algoTek buscarEventoLlamado: evento .	 	resultadoObtenido := unEvento calcularEntradaDe: 'Hospitality'  con: efectivo . "Assert: " self assert: resultadoObtenido closeTo: resultadoEsperado  precision: 0.001! !!EventoTest methodsFor: 'tests' stamp: 'Alexander 9/23/2026 16:14'!test01SeAgregaronDosArtistasNacionalesDiferentesEnELMismoEvento"Arrange"|unEvento resultadoEsperado resultadoObtenido |"Act"resultadoEsperado:= 2.unEvento := Evento registraUnArtistaNacionalDeNombre: 'Charly Garcia' conUnaTarifaDe: 30000.unEvento registraUnArtistaNacionalDeNombre: 'Charly Garcia' conUnaTarifaDe: 30000."Assert"resultadoObtenido:= unEvento decimeLaCantidadDeArtistas."Arrange"self assert: resultadoObtenido equals: resultadoEsperado.! !!EventoTest methodsFor: 'tests' stamp: 'Alexander 9/24/2026 19:05'!test07AUnEventoPuedeCalcularLaEntradaParaUnaUbicacionPlateaPagdoConEfectivo"Arrange"|unEvento evento resultadoEsperado resultadoObtenido |evento := 'La Ultima Noche Magica En River'.resultadoEsperado := (50000 log ) + (12*2000)."Act"unEvento  := Evento deNombre:  evento  conUnArtistaNacional: 'Tan Bionica'deTarifa: 50000.unEvento paraEvento: evento registrarUbicacionPlateaPreferencial: 'M912' tarifa: 2000.resultadoObtenido := unEvento calcularEntradaDe: 'M912' con:Efectivo new ."Assert"self assert: resultadoObtenido  equals: resultadoEsperado .! !!EventoTest methodsFor: 'tests' stamp: 'Alexander 9/24/2026 19:05'!test08AUnEventoPuedeCalcularLaEntradaParaUnaUbicacionEnElCampoPagadoConEfectivo"Arrange"|unEvento evento resultadoEsperado resultadoObtenido |evento := 'La Ultima Noche Magica En River'.resultadoEsperado := (50000 log ) + 16000."Act"unEvento  := Evento deNombre:  evento  conUnArtistaNacional: 'Tan Bionica'deTarifa: 50000.unEvento paraEvento: evento registrarUbicacionCampo: 'Campo General' tarifa: 16000.resultadoObtenido := unEvento calcularEntradaDe: 'Campo General' con: Efectivo new.."Assert"self assert: resultadoObtenido  equals: resultadoEsperado .! !!EventoTest methodsFor: 'tests' stamp: 'Alexander 9/24/2026 19:06'!test09AUnEventoPuedeCalcularLaEntradaParaUnaUbicacionEnElEspacioVipPagadoConEfectivo"Arrange"|unEvento evento resultadoEsperado resultadoObtenido |evento := 'La Ultima Noche Magica En River'.resultadoEsperado := (50000 log ) + (40000/10)."Act"unEvento  := Evento deNombre:  evento  conUnArtistaNacional: 'Tan Bionica'deTarifa: 50000.unEvento paraEvento: evento registrarUbicacionViP: 'Hospitality' tarifa:  40000 lugaresDisponibles: 10.resultadoObtenido := unEvento calcularEntradaDe: 'Hospitality'  con: Efectivo  new ."Assert"self assert: resultadoObtenido  closeTo: resultadoEsperado precision:  0.001 .! !TestCase subclass: #UbicacionTest	instanceVariableNames: ''	classVariableNames: ''	package: 'Tp1-Casos-De-Uso'!!UbicacionTest methodsFor: 'tests' stamp: 'Alexander 9/23/2026 17:33'!test01UnaUbicacionPlateaCalculaElPrecioDelLugar"Arrange"|unaUbicacion resultadoEsperado resultadoObtenido |resultadoEsperado := 12*25000."Act"unaUbicacion := Platea  conLugarEn:'M912' yUnaTarifaDe:25000.resultadoObtenido:= unaUbicacion calcularPrecio."Assert"self assert: resultadoObtenido equals: resultadoEsperado! !