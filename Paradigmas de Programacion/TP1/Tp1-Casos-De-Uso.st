Naranja'."Tiene undescuento del 15 %"		algoTek paraEvento: evento registrarUbicacionPlateaPreferencial: ubicacionElegida tarifa: 25000.		costoEsperado := (((100000 * 2) / 5 + 1000)+(12*25000)) * 0.85.		"Assert"self should: [algoTek costoEntradaPara: evento  enUbicacion: 'UbicacionInexistente' pagandoCon: tarjeta]raise:  UbicacionNoEncontrada  .! !!AlgoTekTestPropios methodsFor: 'tests' stamp: 'Alexander 10/15/2026 17:24'!test01NoSePuedeAgregarUnaTarifaDelArtistaNacionalNegativa| evento  |"Arrange"evento:= 'La Ultima Noche Magica En River'."Act""Assert"self should: [	AlgoTek registrarEvento: evento deArtistaNacional: 'Tan Bionica' conTarifaArtista: -12.	] raise: ValorInvalidoTarifaDelArtistaInvalido  .! !!AlgoTekTestPropios methodsFor: 'tests' stamp: 'Alexander 10/15/2026 17:26'!test05NoSePuedeAgregarUnatarifaDeUnaUbicacionVipInvalido| algoTek evento  |"Arrange"evento:= 'La Ultima Noche Magica En River'."Act"algoTek := AlgoTek registrarEvento: 'La Ultima Noche Magica En River' deArtistaNacional: 'Tan Bionica' conTarifaArtista: 50000.algoTek paraEvento: evento registrarUbicacionViP: 'Hospitality' tarifa: 40000 lugaresDisponibles: 2."Assert"self should: [	algoTek paraEvento: evento registrarUbicacionViP: 'Hospitality' tarifa: -23 lugaresDisponibles: 2.	] raise: ValorInvalidoTarifaDeUbicacionInvalido   .! !!AlgoTekTestPropios methodsFor: 'tests' stamp: 'Alexander 10/15/2026 17:26'!test06NoSePuedeAgregarUnaCantidadDeLugaresInvalidosEnLosVips| algoTek evento  |"Arrange"evento:= 'La Ultima Noche Magica En River'."Act"algoTek := AlgoTek registrarEvento: 'La Ultima Noche Magica En River' deArtistaNacional: 'Tan Bionica' conTarifaArtista: 50000.algoTek paraEvento: evento registrarUbicacionViP: 'Hospitality' tarifa: 40000 lugaresDisponibles: 2."Assert"self should: [	algoTek paraEvento: evento registrarUbicacionViP: 'Hospitality' tarifa: 40000 lugaresDisponibles: -2.	] raise: ValorInvalidoCantidadDeLugaresDisponibles    .! !!AlgoTekTestPropios methodsFor: 'tests' stamp: 'Ale 10/14/2026 03:17'!test02NoSePuedeAgregarUnaTarifaDelArtistaInternacionalNegativa|  evento   |"Arrange"evento:= 'La Ultima Noche Magica En River'."Act""Assert"self should: [	AlgoTek registrarEvento: evento deArtistaInternacional: 'Taylor Swift' conTarifaArtista: -1 .	] raise: ValorInvalidoTarifaDelArtistaInvalido  .! !!AlgoTekTestPropios methodsFor: 'tests' stamp: 'Alexander 10/15/2026 17:28'!test10BuscarUnEventoQueNoExisteLanzaUnaExcepsion	|  costoEsperado ubicacionElegida algoTek evento tarjeta |		"Arrange"	evento := 'The Eras Tour, en River'.	algoTek := AlgoTek registrarEvento: evento deArtistaInternacional: 'Taylor Swift' conTarifaArtista: 100000.	"act"	ubicacionElegida := 'M912'.	tarjeta := Tarjeta conNombre: 'Naranja'."Tiene undescuento del 15 %"		algoTek paraEvento: evento registrarUbicacionPlateaPreferencial: ubicacionElegida tarifa: 25000.		costoEsperado := (((100000 * 2) / 5 + 1000)+(12*25000)) * 0.85.		"Assert"self should: [algoTek costoEntradaPara: 'EvetoInexistente' enUbicacion: ubicacionElegida pagandoCon: tarjeta]raise:  EventoNoEncontrado .! !!AlgoTekTestPropios methodsFor: 'tests' stamp: 'Alexander 10/15/2026 17:22'!test12CuandoNoHayLugaresDisponiblesEnUnaUbicacionVipLanzarUnaExcepcion	| costoAPagar costoEsperado ubicacionElegida algoTek evento efectivo |		"Arrange"	evento := 'The Eras Tour, en River'.	efectivo := Efectivo new.	algoTek := AlgoTek registrarEvento: evento deArtistaInternacional: 'Taylor Swift' conTarifaArtista: 100000.	ubicacionElegida := 'Its a Love Story'.	algoTek paraEvento: evento registrarUbicacionViP: 'Its a Love Story' tarifa: 85000 lugaresDisponibles: 2.	"Ya se saco esta el 'Its a Love Story', por lo tanto se reduce el lugar disponible"	algoTek costoEntradaPara: evento enUbicacion: ubicacionElegida pagandoCon: efectivo.	"Al ser un artista internacional, el impuesto 'al disfrute'"	costoEsperado := (100000 * 2) / 5 + 1000.		"Al ser 'Its a Love Story', la tarifa se va encareciendo a medida que se van ocupando los lugares"	costoEsperado := costoEsperado + (85000 / 1).	"Act"		costoAPagar := algoTek costoEntradaPara: evento enUbicacion: ubicacionElegida pagandoCon: efectivo.		"Assert"	self should:[ algoTek costoEntradaPara: evento enUbicacion: ubicacionElegida pagandoCon: efectivo.]  raise: SinLugaresDisponibles .! !!AlgoTekTestPropios methodsFor: 'tests' stamp: 'Alexander 10/15/2026 17:25'!test05NoSePuedeAgregarUnatarifaDeUnaUbicacionEnElCampoInvalido| algoTek evento  |"Arrange"evento:= 'La Ultima Noche Magica En River'."Act"algoTek := AlgoTek registrarEvento: 'La Ultima Noche Magica En River' deArtistaNacional: 'Tan Bionica' conTarifaArtista: 50000.algoTek paraEvento: evento registrarUbicacionCampo: 'Campo General' tarifa: 16000."Assert"self should: [	algoTek paraEvento: evento registrarUbicacionCampo: 'Campo General' tarifa: -12.	] raise: ValorInvalidoTarifaDeUbicacionInvalido   .! !TestCase subclass: #ArtistaTest	instanceVariableNames: ''	classVariableNames: ''	package: 'Tp1-Casos-De-Uso'!!ArtistaTest methodsFor: 'tests' stamp: 'Ale 10/13/2026 20:41'!test01UnArtistaNacionalSabeQueElEstadoLoSubsidia"Arrange"|unArtista resultadoEsperado resultadoObtenido |resultadoEsperado := 50000 log."Act"unArtista := Nacional conNombre: 'Tan Bionica' yUnaTarifaDe: 50000.resultadoObtenido:= unArtista calcularCosto."Assert"self assert: resultadoObtenido equals: resultadoEsperado! !!ArtistaTest methodsFor: 'tests' stamp: 'Ale 10/14/2026 03:54'!test02UnArtistaInteracionalSabeQueTieneImpuestos"Arrange"|unArtista resultadoEsperado resultadoObtenido |resultadoEsperado := (100000 * 2) / 5 + 1000."Act"unArtista := Internacional  conNombre: 'Taylor Swift' yUnaTarifaDe: 100000.resultadoObtenido:= unArtista calcularCosto."Assert"self assert: resultadoObtenido equals: resultadoEsperado! !TestCase subclass: #EventoTest	instanceVariableNames: ''	classVariableName