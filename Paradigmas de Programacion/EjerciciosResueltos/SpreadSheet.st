Object subclass: #DirCelda	instanceVariableNames: 'valorDeLaDireccionComoString'	classVariableNames: ''	package: 'SpreadSheet'!!DirCelda methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 3/28/2026 07:50'!str 	^ valorDeLaDireccionComoString .! !!DirCelda methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 3/28/2026 14:30'!fila	^ valorDeLaDireccionComoString squeezeOutNumber .! !!DirCelda methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 3/30/2026 13:12'!contenidoVertical: dirDesde y: dirHasta 	^ (dirDesde fila <= self fila ) and: [ self fila <= dirHasta fila ].! !!DirCelda methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 3/30/2026 13:13'!entre: dirDesde y: dirHasta 	^ (self contenidoVertical: dirDesde y: dirHasta ) and: (self contenidoHorizontal: dirDesde y: dirHasta ).	"^ (dirDesde fila <= self fila ) and: [ self fila <= dirHasta fila ]."! !!DirCelda methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 3/30/2026 13:13'!contenidoHorizontal: dirDesde y: dirHasta 	^ (dirDesde columna <= self columna ) and: [ self columna <= dirHasta columna ].! !!DirCelda methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 3/30/2026 13:14'!columna	^valorDeLaDireccionComoString asUppercase withoutTrailingDigits .! !!DirCelda methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 3/28/2026 07:50'!dir: unaDirComoString	valorDeLaDireccionComoString := unaDirComoString .! !!DirCelda methodsFor: 'comparing' stamp: 'AlexanderCruz 3/28/2026 07:50'!= otraDir	^  valorDeLaDireccionComoString asUppercase  = (otraDir str) asUppercase .! !Object subclass: #RangoHorizontal	instanceVariableNames: 'desde hasta'	classVariableNames: ''	package: 'SpreadSheet'!!RangoHorizontal methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 3/30/2026 13:07'!desde: dirDesde hasta: dirHasta 	desde := DirCelda new dir: dirDesde .	hasta := DirCelda new dir: dirHasta .! !!RangoHorizontal methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 3/30/2026 13:08'!estaContenido: unaDireccionComoString 	|dirConsulta|	dirConsulta := DirCelda new dir: unaDireccionComoString .	^ dirConsulta entre:  desde y: hasta . ! !Object subclass: #RangoVertical	instanceVariableNames: 'desde hasta'	classVariableNames: ''	package: 'SpreadSheet'!!RangoVertical methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 3/28/2026 07:44'!desde: dirCeldaDesde hasta: dirCeldaHasta 	desde:=DirCelda new dir: dirCeldaDesde .	hasta:=DirCelda  new dir: dirCeldaHasta .! !!RangoVertical methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 3/28/2026 14:29'!estaContenido: unaDireccionCeldaComoString 	|direccionConsulta|	direccionConsulta := DirCelda new dir: unaDireccionCeldaComoString.	^ direccionConsulta entre: desde y:hasta.! !