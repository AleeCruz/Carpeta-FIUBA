Object subclass: #Club	instanceVariableNames: 'tarifaSocioComun tarifaSocioVIP todosLosSocios pagos nombreDeClub'	classVariableNames: ''	package: 'tp0.5'!!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/7/2026 12:18'!recaudacionTotal	|total|		total :=  pagos inject:  0 into: [ :suma :unPago | suma +unPago  ].		^total.! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/7/2026 12:23'!recibirPagoDe: unNombreDeSocioSendForCLub 	|algunSocio|	algunSocio := todosLosSocios detect: [ :unSocio | unSocio nombre = unNombreDeSocioSendForCLub].		pagos add: (algunSocio decimeElPrecioDeTuCategoria).! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/7/2026 12:21'!cantidadPagadaPor: unNombreDeSocio 	|algunSocio|	algunSocio := todosLosSocios detect: [ :unSocio | unSocio nombre = unNombreDeSocio].	^ algunSocio decimeElPrecioDeTuCategoria.! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/7/2026 12:10'!cantidadDeSocios	^ todosLosSocios size. ! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/7/2026 11:38'!establecerTarifaSocio:  unaTarifaSocioComun	tarifaSocioComun := unaTarifaSocioComun .	! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/7/2026 11:53'!agregarSocio: algunSocioEnviadoPorClub 	|unSocio|	unSocio := Socio new.	unSocio establecerNombre: (algunSocioEnviadoPorClub nombre ) conPrecioDeCategoria: tarifaSocioComun .	todosLosSocios add: unSocio .! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/7/2026 12:15'!establecerNombre: unNombreDeClub 	nombreDeClub := unNombreDeClub .! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/7/2026 12:05'!nombresSocios	|filtrandoObjetosPorMetodo coleccionDeNombres|	filtrandoObjetosPorMetodo := todosLosSocios select: [ :unSocio | unSocio respondsTo: #nombre ].	coleccionDeNombres := filtrandoObjetosPorMetodo collect: [ :unSocio | unSocio nombre ].	^ coleccionDeNombres asSet.! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/7/2026 12:18'!agregarSocioVIP: algunSocioEnviadoPorClub 	|unSocio|	unSocio := Socio new.	unSocio establecerNombre: (algunSocioEnviadoPorClub nombre ) conPrecioDeCategoria: tarifaSocioVIP.	todosLosSocios add: unSocio .! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/7/2026 11:39'!establecerTarifaSocioVIP: unaTarifaSocioVIP 	tarifaSocioVIP := unaTarifaSocioVIP .! !!Club methodsFor: 'initialization' stamp: 'AlexanderCruz 4/7/2026 12:15'!initialize 	todosLosSocios := OrderedCollection new.	pagos := OrderedCollection new.! !Object subclass: #Socio	instanceVariableNames: 'nombre precioDeCategoria'	classVariableNames: ''	package: 'tp0.5'!!Socio methodsFor: 'accessing' stamp: 'AlexanderCruz 4/7/2026 11:47'!nombre	^ nombre deepCopy .! !!Socio methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/7/2026 11:40'!establecerNombre: unNombreDeSocio 	nombre := unNombreDeSocio .! !!Socio methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/7/2026 12:15'!decimeElPrecioDeTuCategoria	^ precioDeCategoria deepCopy.! !!Socio methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/7/2026 11:50'!establecerNombre: unNombreDeSocio conPrecioDeCategoria: unPrecioDeCategoria 	nombre := unNombreDeSocio .	precioDeCategoria := unPrecioDeCategoria.! !