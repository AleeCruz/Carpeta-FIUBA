Object subclass: #Club	instanceVariableNames: 'nombre tarifaSocioComun tarifaSocioVIP sociosVIP sociosComunes pagos'	classVariableNames: ''	package: 'tp0.5'!!Club methodsFor: 'initialization' stamp: 'AlexanderCruz 4/6/2026 16:06'!initialize 	sociosComunes :=OrderedCollection new.	sociosVIP := OrderedCollection new.	pagos := OrderedCollection new.! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/6/2026 15:52'!nombresSocios	|socios_1 socios_2 resultado|	socios_1  := sociosComunes collect: [ :unSocio | unSocio decimeTuNombre].	socios_2  := sociosVIP collect: [ :unSocio | unSocio decimeTuNombre ].	resultado := socios_1 ,socios_2 .	^ resultado asSet .! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/6/2026 15:35'!establecerTarifaSocioVIP: unaTarifaSocioVIP 	tarifaSocioVIP := unaTarifaSocioVIP .! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/6/2026 16:17'!agregarSocioVIP: unSocioVIP	unSocioVIP deCategoria: 'VIP'.	sociosVIP add: unSocioVIP .! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/6/2026 15:34'!establecerTarifaSocio: unaTarifaSocioComun	tarifaSocioComun := unaTarifaSocioComun .! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/6/2026 21:44'!recibirPagoDe: unNombreComoString  	|unSocio  allSocios|	allSocios := sociosVIP ,sociosComunes .	unSocio := allSocios detect: [:algunSocio |algunSocio decimeTuNombre = unNombreComoString  ] .	pagos add: unSocio  .! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/6/2026 15:33'!establecerNombre: unNombreDeClub 	nombre := unNombreDeClub .! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/6/2026 15:54'!cantidadDeSocios	|cantidadDeSocios|	cantidadDeSocios := (sociosComunes size) + (sociosVIP size ).	^ cantidadDeSocios .! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/6/2026 21:34'!agregarSocio: unSocio 	unSocio deCategoria: 'comun'.	sociosComunes add: unSocio .! !!Club methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/6/2026 21:47'!recaudacionTotal	|total allSocios|	allSocios := sociosVIP ,sociosComunes .	total    := pagos   inject: 0 into:[:suma :unPago | suma + unPago  decimeTuPago].	^   total .! !Object subclass: #Pago	instanceVariableNames: 'pagos'	classVariableNames: ''	package: 'tp0.5'!!Pago methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/6/2026 21:46'!cuantoPagaste: unSocio	|pago|	pago  := unSocio decimeTuPago.	^ pago .	! !!Pago methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/6/2026 16:09'!decimeTuPago	self shouldBeImplemented.! !Object subclass: #Socio	instanceVariableNames: 'nombre categoria'	classVariableNames: ''	package: 'tp0.5'!!Socio methodsFor: 'initialization' stamp: 'AlexanderCruz 4/6/2026 16:19'!initialize 	nombre := ' '.	categoria := 'Sin Definir'.! !!Socio methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/6/2026 16:22'!decimeTuPago	(categoria = 'comun') ifTrue: [ ^500].	(categoria = 'VIP') ifTrue: [ ^700 ].	! !!Socio methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/6/2026 15:36'!establecerNombre: unNombre 	nombre := unNombre .! !!Socio methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/6/2026 16:18'!deCategoria: unaCategoria 	categoria := unaCategoria .! !!Socio methodsFor: 'as yet unclassified' stamp: 'AlexanderCruz 4/6/2026 15:53'!decimeTuNombre	^ nombre deepCopy .! !