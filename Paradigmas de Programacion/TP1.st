Object subclass: #AlgoConsejo	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!AlgoConsejo class	instanceVariableNames: 'criterio futbolistas resultado conmebolPaises'!!AlgoConsejo class methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 12:28'!compararCon: unValorEsperado precision: unaPresicion|diferencia|diferencia := (resultado - unValorEsperado) abs.^ (diferencia < unaPresicion ).! !!AlgoConsejo class methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 12:31'!valorDe: unNombreFutbolista|unFutbolista valor|valor := Valor new.unFutbolista := futbolistas detect: [ :f | (f dameTuNombre) = unNombreFutbolista].valor asignaResultado: (unFutbolista dameTuValorEnPesos).^ valor 	 ! !!AlgoConsejo class methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 13:57'!registrarFutbolistaConNombre: unNombreDeFutbolista dePeso: unPeso yAltura: unaAltura yEdad: unaEdad yProvenienteDelClub: unClub DePais: unPais |unFutbolista|('Argentina' = unPais )	ifTrue: [ 			unFutbolista := Argentino new.		 ]	ifFalse: [ 			(conmebolPaises includes: unPais )				ifTrue: [ unFutbolista := Conmebol new. ]				ifFalse: [ 					(unaEdad  > 33)						ifTrue: [ unFutbolista := Extranjero_Veterano new ]						ifFalse: [ unFutbolista := Extranjero new ]					 ]		].	unFutbolista asignarNombre: unNombreDeFutbolista  Peso: unPeso Altura: unaAltura  Edad: unaEdad  Club: unClub  Pais: unPais Criterio: criterio.	unFutbolista calculaTuValorEnPesos. 	futbolistas add: unFutbolista.	! !!AlgoConsejo class methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 14:01'!obtenerFutbolistaSegunCriterio|unFutbolista seleccionados|(criterio = 'Caro')	ifTrue: [ 		seleccionados := futbolistas select: [ :f | (f dameTuCriterio ) = criterio  ].		unFutbolista := seleccionados detectMax: [ :f | (f dameTuValorEnPesos ) ].	 	]	ifFalse: [ 		seleccionados := futbolistas select: [ :f | (f dameTuCriterio ) = criterio  ].		unFutbolista := seleccionados detectMin: [ :f | (f dameTuValorEnPesos ) ].		 ].^ unFutbolista dameTuNombre .! !!AlgoConsejo class methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 13:26'!conCriterioMas: unCriterio 	criterio := unCriterio.	futbolistas := OrderedCollection new.	conmebolPaises := OrderedCollection new.		conmebolPaises add: 'Bolivia'.	conmebolPaises add: 'Brasil'.	conmebolPaises add: 'Chile'.	conmebolPaises add: 'Colombia'.	conmebolPaises add: 'Ecuador'.	conmebolPaises add: 'Paraguay'.	conmebolPaises add: 'Perú'.	conmebolPaises add: 'Peru'.	conmebolPaises add: 'Uruguay'.	conmebolPaises add: 'Venezuela'.	conmebolPaises add: 'Argentina'.! !Object subclass: #Futbolista	instanceVariableNames: 'nombre peso altura edad club pais criterio valorEnPesos'	classVariableNames: ''	package: 'TP1'!!Futbolista methodsFor: 'initialization' stamp: 'Alexander 10/15/2025 12:18'!initialize 	nombre := 'No asignado'.	peso := 0.	altura := 0.00.	edad := 0.	club := 'No Asigando'.	pais := 'No Asignado'.	criterio := 'No Asignado'.! !!Futbolista methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 10:34'!dameTuCriterio	^criterio.! !!Futbolista methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 11:23'!asignarNombre: unNombre Peso: unPeso Altura: unaAltura Edad: unaEdad Club: unClub Pais: unPais Criterio: unCriterio	nombre := unNombre.	peso := unPeso.	altura := unaAltura .	edad := unaEdad .	club := unClub .	pais := unPais.	criterio := unCriterio.! !!Futbolista methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 12:23'!dameTuValorEnPesos  ^ valorEnPesos ! !!Futbolista methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 10:34'!decimeTuPais	^pais.! !!Futbolista methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 10:34'!decimeTuClub	^club.! !!Futbolista methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 10:32'!dameTuPeso	^peso .! !!Futbolista methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 10:33'!dameTuAltura^altura ! !!Futbolista methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 10:32'!dameTuNombre	^nombre .! !!Futbolista methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 10:33'!dameTuEdad	^edad ! !Futbolista subclass: #Argentino	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Argentino methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 12:43'!calculaTuValorEnPesos	valorEnPesos := ((peso * altura)/edad)*1.1.! !Futbolista subclass: #Conmebol	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Conmebol methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 12:44'!calculaTuValorEnPesos 		valorEnPesos := ((peso * altura)/edad)*1.25.! !Futbolista subclass: #Extranjero	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Extranjero methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 12:46'!calculaTuValorEnPesos 	valorEnPesos := ((peso * altura)/edad)*1.5.! !Futbolista subclass: #Extranjero_Veterano	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1'!!Extranjero_Veterano methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 13:43'!calculaTuValorEnPesos 	valorEnPesos :=  ((100*peso*(altura sqrt)) / (edad raisedTo: 3))*1.5.! !Object subclass: #Valor	instanceVariableNames: 'resultado'	classVariableNames: ''	package: 'TP1'!!Valor methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 12:09'!asignaResultado: unResultado 	resultado := unResultado .! !!Valor methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 16:43'!compararCon: unValorEsperado precision: unaPresicion^ unValorEsperado closeTo:  resultado  precision: unaPresicion . ! !!Valor methodsFor: 'as yet unclassified' stamp: 'Alexander 10/15/2025 16:46'!compararConValorEnReales: unValorEnReales precision: unaPresicionresultado  := (resultado/245).^ unValorEnReales closeTo: resultado precision: unaPresicion .! !