@startuml
skinparam classAttributeIconSize 0
hide circle

class AlgoTek {
    #eventos: Collection

    +RegistrarEventoDeArtista(unNombreEvento: String, unArtista: Artista): AlgoTek
    +buscarEventoLlamado(unNombredeEvento: String): Evento
    +costoEntradaParaEnUbicacionPagandoCon(unNombreEvento: String, unNombreUbicacion: String, unMedioDePago: MedioDePago): Int
    +entradaMasBarataParaPagandoCon(unNombreDeEvento: String, unMedioDEPago: MedioDePago): Int
    +paraEventoRegistrarUbicacionPlateaTarifa(unNombreDeEvento: String, unNombreDeUbicacion: String, unaTarifaParaLaUbicacion: Number)
    +paraEventoRegistrarUbicacionCampoTarifa(unNombreDeEvento: String, unNombreDeUbicacion: String, unaTarifaParaLaUbicacion: Number)
    +paraEventoRegistrarUbicacionViPTarifaLugaresDisponibles(unNombreDeEvento: String, unNombreDeUbicacion: String, unaTarifa: Number, unaCantidadDeLugares: Number)
    {static} +registrarEventoDeArtistaNacionalConTarifaArtista(unNombreEvento: String, unNombreArtistaNacional: String, unaTarifa: Number): AlgoTek
    {static} +registrarEventoDeArtistaInternacionalConTarifaArtista(unNombreEvento: String, unNombreArtistaNacional: String, unaTarifa: Number): AlgoTek
}

class Evento {
    -nombreDelEvento: String

    +DeNombreConUnArtista(unNombreDeEvento: String, unArtista: Artista): Evento
    +conNombre(unNombre: String): Boolean
    +calcularEntradaDeCon(unNombreDeUbicacion: String, unMedioDePago: MedioDePago): Int
    +entradaMasBarataPagandoCon(unMedioDePago: MedioDePago): Int
    +registrarUbicacion(unaUbicacion: Ubicacion): Void
    {static} +deNombreConUnArtista(unNombreDeEvento: String, unArtista: Artista): Evento
}

abstract Ubicacion <<Abstract>>{
    #nombre: String
    #tarifaUbicacion: Int

    +Ubicacion(unNombreDeLugar: String, unaTarifaDelLugar: Int)
    +conNombre(unNombreDeUbicacion: String): Boolean
    {abstract}+calcularPrecio(): Int
    {static} +conNombreYUnaTarifaDe(unNombreDelLugar: String, unaTarifa: Int): Ubicacion
}

class Platea {
    +calcularPrecio(): Int
}


class Campo {
    +calcularPrecio(): Int
}

class Vip {
    -cantidadDeLugaresDisponibles: Int
    
    +Vip(unNombre:String,unaTarifa:Int,unaCantidad:Int)
    +calcularPrecio(): Int
    {static}+conLugarEnYUnaTarifaDeLugaresDisponibles(String, Int, Int)

}

abstract MedioDePago <<Abstract>> {
    {abstract}+obtenerBeneficio(precioDeEntrada: Int): Int
}

class Efectivo {
    +obtenerBeneficio(unPrecioEntrada:Int):Int
}

 class Tarjeta {
    +obtenerBeneficio(unPrecioEntrada:Int):Int
    {static} +conNombre(unNombre: String): Tarjeta
}


abstract Artista <<Abstract>> {
    #nombre: String
    #tarifaArtista: Number

    +Artista(unNombreDeArtista: String, unaTarifa: Number)
    {abstract}+calcularCosto(): Int
    {static} +conNombreYUnaTarifaDe(unNombre: String, unaTarifa: Number): Artista
}

class Nacional {
    +calcularCosto(): Int
}

class Internacional {
    +calcularCosto(): Int
}





' Relaciones y Multiplicidades
AlgoTek     *-down- "*" Evento: eventos
Evento      o-down-  Artista: artista
Evento      o-left- "*" Ubicacion: ubicaciones
Evento     .right.>MedioDePago


Ubicacion <|-- Platea
Ubicacion <|-- Campo
Ubicacion <|-- Vip

MedioDePago <|-- Efectivo
MedioDePago <|-- Tarjeta

Artista <|-- Nacional
Artista <|-- Internacional

@enduml