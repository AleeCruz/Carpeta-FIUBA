'From Pharo11.0.0 of 28 July 2025 [Build information: Pharo-11.0.0+build.748.sha.c1646bb55445a5f4ae44303010a02118509c481d (64 Bit)] on 25 September 2025 at 11:33:58.420255 pm'!TestCase subclass: #CasosDeUso	instanceVariableNames: ''	classVariableNames: ''	package: 'TP1-TP1-Casos-de-Usos'!!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 9/25/2025 19:28'!test02UnFutbolistaConmebolJovenValeCiertosPesos	| algoConsejo valorEsperado valorObtenido precision |	precision := 1e-3.	"Arrange: Jugador de CONMEBOL (no argentino) y menor de 33 años"	"Fórmula de Futbolista_Conmebol: (peso * altura) / edad = (75 * 1.80) / 25 = 5.4"	valorEsperado := 6.75. 	algoConsejo  := AlgoConsejo conCriterioMas: 'Caro'.	"Registramos un Colombiano (país de CONMEBOL)"	algoConsejo registrarFutbolistaConNombre: 'Luis Díaz' dePeso: 75  yAltura: 1.80 yEdad: 25 yProvenienteDelClub: 'Liverpool' DePais: 'Colombia'.		"Act"	valorObtenido := algoConsejo valorDe: 'Luis Díaz'.			"Assert"	self assert: (valorObtenido compararCon: valorEsperado precision: precision )! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 9/25/2025 22:02'!test12MinimoEsDiferenteDelMaximo	| algoConsejo futbolistaEsperado futbolistaObtenido |		"Arrange"	futbolistaEsperado := 'Kevin Zenon'. "El más barato de los 'Barato'"	algoConsejo := AlgoConsejo conCriterioMas: 'Barato'. 	algoConsejo registrarFutbolistaConNombre: 'Kevin Zenon' dePeso: 72  yAltura: 1.77 yEdad: 24 yProvenienteDelClub: 'Union de Santa Fe' DePais: 'Argentina'.		algoConsejo registrarFutbolistaConNombre: 'Carlos Palacios' dePeso: 75  yAltura: 1.80 yEdad: 25 yProvenienteDelClub: 'Colo Colo' DePais: 'Chile'.		"Act"	futbolistaObtenido := algoConsejo obtenerFutbolistaSegunCriterio.	self assert: futbolistaEsperado equals: futbolistaObtenido! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 9/25/2025 23:10'!testObtenerFutbolistaCaroFiltraCorrectamente    | consejo caro barato resultado |    consejo := AlgoConsejo .    caro := Futbolista_Argentino new.    caro asignarNombre: 'Messi'.    caro asignarPeso: 80.    caro asignarAltura: 170.    caro asignarEdad: 36.    caro asignarClub: 'Inter Miami'.    caro asignarPais: 'Argentina'.    caro aignarCriterio: 'Caro'.    barato := Futbolista_Conmebol new.    barato asignarNombre: 'JugadorX'.    barato asignarPeso: 70.    barato asignarAltura: 175.    barato asignarEdad: 20.    barato asignarClub: 'ClubX'.    barato asignarPais: 'Chile'.    barato aignarCriterio: 'Barato'.    consejo futbolistas: { caro. barato }.    consejo conCriterioMas:  'Caro'.    resultado := consejo obtenerFutbolistaSegunCriterio.    "Debe devolver el nombre del caro"    self assert: resultado = 'Messi'.! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 9/25/2025 22:07'!test11FiltroDeCriterioNoEsTotal	| algoConsejo futbolistaEsperado futbolistaObtenido criterioOriginal |		"Arrange: Configuramos el contexto para buscar al más CARO."	futbolistaEsperado := 'Marco Pellegrino'. 	algoConsejo := AlgoConsejo conCriterioMas: 'Caro'.     criterioOriginal := algoConsejo dameTuCriterio. "Guardamos el 'Caro'"	"1. Registramos a Marco Pellegrino (CARO: Valor ~7.93)"	algoConsejo registrarFutbolistaConNombre: 'Marco Pellegrino' dePeso: 79 yAltura: 1.84 yEdad: 23 yProvenienteDelClub: 'AC Milan' DePais: 'Italia'.		"2. Registramos a Erling Haaland (BARATO: Valor forzado ~15.00)"    "FORZAMOS EL CRITERIO DEL ALGO CONSEJO TEMPORALMENTE para que Haaland se registre como 'Barato'"	algoConsejo asignarCriterio: 'Barato'.	algoConsejo registrarFutbolistaConNombre: 'Erling Haaland' dePeso: 88 yAltura: 1.95 yEdad: 25 yProvenienteDelClub: 'Man City' DePais: 'Noruega'.	    "Restablecemos el criterio para que el Act funcione correctamente"    algoConsejo asignarCriterio: criterioOriginal. "Volvemos a dejar 'Caro'"    	"Act: Buscamos el más CARO"	futbolistaObtenido := algoConsejo obtenerFutbolistaSegunCriterio.			"Assert: El código correcto solo ve a Pellegrino. El mutante ve a Haaland."	self assert: futbolistaEsperado equals: futbolistaObtenido! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 9/25/2025 19:07'!test01UnFutbolistaArgentinoVeteranoConCiertoPesoAlturaYEdadValeCiertosPesos	| algoConsejo valorEsperado valorObtenido precision|	precision := 1e-3.	"Arrange: Jugador Argentino Veterano (38 años)"	"Formula esperada: ((peso * altura) / edad) * 1.10 = ((75 * 1.80) / 38) * 1.10 = 3.934..."	valorEsperado := 3.908. 	algoConsejo  := AlgoConsejo conCriterioMas: 'Barato'.	"Registramos un Argentino mayor de 33 años"	algoConsejo registrarFutbolistaConNombre: 'Carlitos Tevez' dePeso: 75  yAltura: 1.80 yEdad: 38 yProvenienteDelClub: 'Boca Juniors' DePais: 'Argentina'.		"Act"	valorObtenido := algoConsejo valorDe: 'Carlitos Tevez'.			"Assert"	self assert: (valorObtenido compararCon: valorEsperado precision: precision )! !!CasosDeUso methodsFor: 'tests' stamp: 'Alexander 9/25/2025 21:33'!test06PotenciaDeEdadMataMutante	| algoConsejo valorEsperado valorObtenido precision |	precision := 0.01. "Necesitas poca precisión para que el error sea detectado"		"Datos de Palacios (Conmebol): Peso: 75, Altura: 1.80, Edad: 25."        "Cálculo con edad^3 (Valor Esperado, asumiendo una constante 1.0): 0.81"	valorEsperado := 0.81.	algoConsejo := AlgoConsejo conCriterioMas: 'Barato'. "Inicialización necesaria"	"Registramos a Carlos Palacios (Conmebol)"	algoConsejo registrarFutbolistaConNombre: 'Carlos Palacios' dePeso: 75 yAltura: 1.80 yEdad: 25 yProvenienteDelClub: 'Colo Colo' DePais: 'Chile'.		"Act"	valorObtenido := algoConsejo valorDe: 'Carlos Palacios'.			"Assert"	"Si el código usa (edad raisedTo: 3), valorObtenido es ~0.81, PASA."	"Si el mutante cambia a (edad raisedTo: 2), valorObtenido es ~20.27, FALLA."	self assert: (valorObtenido compararCon: valorEsperado precision: precision )! !